<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Aurora.Desktop.Controls.PclMessageDialog"
             x:Name="Root"
             IsVisible="False"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="Button.dialog-button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FBFBFB" />
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="BorderBrush" Value="#343D4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.dialog-button:focus-visible">
            <Setter Property="Background" Value="#ECF5FF" />
            <Setter Property="BorderBrush" Value="#127AE1" />
        </Style>
        <Style Selector="Button.dialog-button:pointerover">
            <Setter Property="Background" Value="#ECF5FF" />
            <Setter Property="Foreground" Value="#127AE1" />
            <Setter Property="BorderBrush" Value="#127AE1" />
        </Style>
        <Style Selector="Button.dialog-button:pressed">
            <Setter Property="Background" Value="#DCEEFF" />
        </Style>
        <Style Selector="Button.dialog-button.primary">
            <Setter Property="Foreground" Value="#0B5BCB" />
            <Setter Property="BorderBrush" Value="#0B5BCB" />
        </Style>
        <Style Selector="Button.dialog-button.primary:pointerover">
            <Setter Property="Foreground" Value="#127AE1" />
            <Setter Property="BorderBrush" Value="#127AE1" />
        </Style>
        <Style Selector="Button.dialog-button.danger">
            <Setter Property="Foreground" Value="#CE2111" />
            <Setter Property="BorderBrush" Value="#CE2111" />
        </Style>
        <Style Selector="Button.dialog-button.danger:focus-visible">
            <Setter Property="Background" Value="#FFF0F0" />
            <Setter Property="Foreground" Value="#CE2111" />
            <Setter Property="BorderBrush" Value="#CE2111" />
        </Style>
        <Style Selector="Button.dialog-button.danger:pointerover">
            <Setter Property="Background" Value="#FFF0F0" />
            <Setter Property="Foreground" Value="#FF4C4C" />
            <Setter Property="BorderBrush" Value="#FF4C4C" />
        </Style>
        <Style Selector="Button.dialog-button.danger:pressed">
            <Setter Property="Background" Value="#FBDDDD" />
        </Style>
    </UserControl.Styles>

    <!-- Geometry, hierarchy and motion states directly adapt PCL-CE MyMsgText/MyMsgInput. -->
    <Grid x:Name="OverlayRoot">
        <Border x:Name="Scrim" Opacity="0" />
        <Grid x:Name="DialogSurface"
              Width="520"
              MinWidth="400"
              MaxWidth="720"
              MaxHeight="440"
              Margin="25"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Opacity="0"
              RenderTransformOrigin="0,0.5"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-4" />
                    <TranslateTransform Y="40" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border Background="#FBFBFB"
                    CornerRadius="7"
                    BoxShadow="0 4 20 2 #CC3C3C3C">
                <Grid Margin="22,22,22,23" RowDefinitions="Auto,2,13,*,Auto">
                    <TextBlock x:Name="DialogTitle"
                               Grid.Row="0"
                               Margin="7,-1,70,9"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               FontSize="23"
                               FontWeight="Light"
                               Foreground="#0B5BCB"
                               TextWrapping="Wrap" />
                    <Border x:Name="TitleDivider"
                            Grid.Row="1"
                            Height="2"
                            Background="#0B5BCB" />

                    <ScrollViewer Grid.Row="3"
                                  MaxHeight="300"
                                  Margin="0,0,0,17"
                                  Padding="7,0,15,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="DialogMessage"
                                       Padding="1"
                                       FontSize="15"
                                       FontWeight="Normal"
                                       Foreground="#343D4A"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                            <ContentControl x:Name="DialogContent"
                                            HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4"
                                Margin="150,0,8,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Button x:Name="PrimaryButton"
                                Classes="dialog-button primary"
                                Click="PrimaryButtonClick" />
                        <Button x:Name="SecondaryButton"
                                Classes="dialog-button"
                                Click="SecondaryButtonClick" />
                        <Button x:Name="TertiaryButton"
                                Classes="dialog-button"
                                Click="TertiaryButtonClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
