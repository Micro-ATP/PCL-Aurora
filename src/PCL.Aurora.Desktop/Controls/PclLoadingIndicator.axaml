<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Aurora.Desktop.Controls.PclLoadingIndicator"
             x:Name="Root"
             MinWidth="120"
             MinHeight="110">
    <!-- Pickaxe geometry and motion structure directly adapt PCL/PCL-CE MyLoading. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Grid Width="60" Height="47" HorizontalAlignment="Center">
            <Path x:Name="PickaxePath" Width="44" Height="35" Margin="10,6,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Stretch="Uniform" Stroke="#4A91D9" StrokeThickness="2"
                  Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z">
                <Path.RenderTransform>
                    <RotateTransform Angle="25" CenterX="30" CenterY="30" />
                </Path.RenderTransform>
            </Path>
            <Rectangle Width="25" Height="2" Fill="#4A91D9"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left" />
        </Grid>
        <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="#3477B8"
                   Text="{Binding Text, ElementName=Root}" />
    </StackPanel>
</UserControl>
