<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Aurora.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <FontFamily x:Key="PclAuroraInterfaceFont">avares://PCL.Aurora.Desktop/Fonts/HarmonyOS_Sans_SC#HarmonyOS Sans SC</FontFamily>
        <SolidColorBrush x:Key="PclThemePrimaryBrush" Color="#127AE1" />
        <SolidColorBrush x:Key="PclPageBackgroundBrush" Color="#D9EAF9" />
        <SolidColorBrush x:Key="PclTextPrimaryBrush" Color="#343D4A" />
        <SolidColorBrush x:Key="PclTextSecondaryBrush" Color="#6F7C8B" />
        <SolidColorBrush x:Key="PclTextMutedBrush" Color="#87929D" />
        <SolidColorBrush x:Key="PclSurfaceBrush" Color="#FCFDFF" />
        <SolidColorBrush x:Key="PclSurfaceRaisedBrush" Color="#FBFBFB" />
        <SolidColorBrush x:Key="PclCardBrush" Color="#D2FBFBFB" />
        <SolidColorBrush x:Key="PclCardHoverBrush" Color="#EAF2FE" />
        <SolidColorBrush x:Key="PclControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PclControlHoverBrush" Color="#F8FBFE" />
        <SolidColorBrush x:Key="PclControlPressedBrush" Color="#F2F8FF" />
        <SolidColorBrush x:Key="PclControlSelectedBrush" Color="#E4F1FF" />
        <SolidColorBrush x:Key="PclControlSelectedHoverBrush" Color="#DCEEFF" />
        <SolidColorBrush x:Key="PclControlBorderBrush" Color="#C3D2E2" />
        <SolidColorBrush x:Key="PclControlAccentBorderBrush" Color="#83B8F8" />
        <SolidColorBrush x:Key="PclDividerBrush" Color="#D1DDEA" />
        <SolidColorBrush x:Key="PclDisabledSurfaceBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="PclDisabledTextBrush" Color="#9AA5B1" />
        <SolidColorBrush x:Key="PclHintBackgroundBrush" Color="#EAF4FF" />
        <SolidColorBrush x:Key="PclHintBorderBrush" Color="#BFD9F3" />
        <SolidColorBrush x:Key="PclWarningBackgroundBrush" Color="#FFF5D6" />
        <SolidColorBrush x:Key="PclWarningBorderBrush" Color="#E8D69A" />
        <SolidColorBrush x:Key="PclWarningTextBrush" Color="#765B00" />
        <SolidColorBrush x:Key="PclDangerBackgroundBrush" Color="#80FBDDDD" />
        <SolidColorBrush x:Key="PclDangerTextBrush" Color="#A44343" />
        <SolidColorBrush x:Key="PclSuccessBackgroundBrush" Color="#E8F7EE" />
        <SolidColorBrush x:Key="PclSuccessTextBrush" Color="#287A49" />
        <SolidColorBrush x:Key="PclOverlaySurfaceBrush" Color="#F2FFFFFF" />
        <ControlTheme x:Key="PclScrollBarThumbTheme" TargetType="Thumb">
            <Setter Property="Background" Value="#804890F5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#E61370F3" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#FF4890F5" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="PclScrollBarPageButtonTheme" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource PclAuroraInterfaceFont}" />
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MaxWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Vertical"
                           IsDirectionReversed="True">
                        <Track.DecreaseButton>
                            <RepeatButton Theme="{StaticResource PclScrollBarPageButtonTheme}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Theme="{StaticResource PclScrollBarPageButtonTheme}" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb Width="8" MinHeight="20" Theme="{StaticResource PclScrollBarThumbTheme}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="MaxHeight" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Horizontal">
                        <Track.DecreaseButton>
                            <RepeatButton Theme="{StaticResource PclScrollBarPageButtonTheme}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Theme="{StaticResource PclScrollBarPageButtonTheme}" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb Height="8" MinWidth="20" Theme="{StaticResource PclScrollBarThumbTheme}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
