<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Aurora.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="PCL.Aurora.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        MinWidth="800"
        MinHeight="560"
        Title="PCL Aurora">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="24,18" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="PCL Aurora" />
                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="跨平台启动器 · 迁移预览" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="macOS · .NET 10" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16" TabStripPlacement="Left">
            <TabItem Header="启动">
                <ScrollViewer>
                    <StackPanel Margin="28" MaxWidth="860" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="启动游戏" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="选择实例、账户和 Java 后启动 Minecraft。" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Padding="24" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="本地实例" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding InstanceSummary}" TextWrapping="Wrap" />
                                <Label Content="启动实例" Target="{Binding #InstanceSelector}" />
                                <ComboBox x:Name="InstanceSelector"
                                          Width="360"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="启动实例"
                                          IsEnabled="{Binding HasAvailableInstances}"
                                          ItemsSource="{Binding AvailableInstances}"
                                          SelectedItem="{Binding SelectedInstance}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding VersionId}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding VersionMetadataSummary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Command="{Binding RefreshCommand}" Content="刷新本地实例" />
                                    <Button Command="{Binding LaunchGameCommand}" IsEnabled="{Binding CanLaunchGame}" Content="启动游戏" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="账户 · 离线模式" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="本机仅保存通过校验的离线用户名；微软与 Authlib-Injector 登录将在安全认证服务完成后提供。"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="离线用户名" />
                                <TextBox PlaceholderText="离线用户名（3–16 位）" Text="{Binding OfflinePlayerName}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Command="{Binding UseOfflineAccountCommand}" Content="使用离线账户" />
                                    <Button Command="{Binding ClearOfflineAccountCommand}" Content="清除离线账户" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="启动迁移状态" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding LaunchPreflightSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding LaunchArgumentSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding ClasspathSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding GameLaunchSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="下载">
                <ScrollViewer>
                    <StackPanel Margin="28" MaxWidth="860" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="下载" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="社区资源与游戏组件安装入口。" />
                        </StackPanel>

                        <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Left">
                            <Border Width="300" Margin="0,0,16,16" Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="社区资源" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="模组、整合包、数据包、资源包、光影与存档。" TextWrapping="Wrap" />
                                    <Button IsEnabled="False" Content="浏览资源" />
                                </StackPanel>
                            </Border>
                            <Border Width="300" Margin="0,0,16,16" Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="游戏安装" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="先选择官方 Minecraft 版本，再创建本地实例并下载。" TextWrapping="Wrap" />
                                    <TextBlock Text="搜索版本 ID" />
                                    <TextBox PlaceholderText="例如 1.21.4 或 24w14a"
                                             Text="{Binding VersionSearchText}" />
                                    <WrapPanel ItemHeight="32" ItemWidth="92">
                                        <CheckBox Content="正式版" IsChecked="{Binding IncludeReleaseVersions}" />
                                        <CheckBox Content="快照" IsChecked="{Binding IncludeSnapshotVersions}" />
                                        <CheckBox Content="旧版" IsChecked="{Binding IncludeLegacyVersions}" />
                                    </WrapPanel>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedCatalogVersion}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Id}" />
                                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               Text="{Binding Type}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding RefreshVersionCatalogCommand}" Content="刷新官方版本" />
                                    <Button Command="{Binding ProvisionSelectedVersionCommand}" IsEnabled="{Binding CanProvisionSelectedVersion}" Content="创建所选实例" />
                                    <Button Command="{Binding InstallGameCommand}" IsEnabled="{Binding CanInstallGame}" Content="安装所选本地实例" />
                                </StackPanel>
                            </Border>
                            <Border Width="300" Margin="0,0,16,16" Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="模组加载器" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="导入用户指定的本地目录，按所选原版版本筛选 Forge、NeoForge 和 Fabric。"
                                               TextWrapping="Wrap" />
                                    <TextBox PlaceholderText="本地 loaders.json 的完整路径"
                                             Text="{Binding LoaderCatalogPath}" />
                                    <Button Command="{Binding LoadLoaderCatalogCommand}" Content="读取本地加载器目录" />
                                    <ComboBox IsEnabled="{Binding HasAvailableLoaders}"
                                              ItemsSource="{Binding AvailableLoaders}"
                                              SelectedItem="{Binding SelectedLoader}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
                                                    <TextBlock Text="{Binding Version}" />
                                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               Text="{Binding Channel}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="{Binding LoaderCatalogSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="{Binding LoaderSelectionSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding DownloadPreparationSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding InstallationSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding VersionCatalogSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer>
                    <StackPanel Margin="28" MaxWidth="860" Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="游戏、工具、启动器与关于信息。" />
                        </StackPanel>

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="游戏 · Java" />
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" RowSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="系统架构" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET 运行时" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据目录" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApplicationDataDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="缓存目录" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CacheDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Java" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding JavaSummary}" TextWrapping="Wrap" />
                                </Grid>
                                <Label Content="启动 Java" Target="{Binding #JavaSelector}" />
                                <ComboBox x:Name="JavaSelector"
                                          MinWidth="360"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="启动 Java"
                                          IsEnabled="{Binding HasAvailableJavaInstallations}"
                                          ItemsSource="{Binding AvailableJavaInstallations}"
                                          SelectedItem="{Binding SelectedJava}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding Vendor}" />
                                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding ExecutablePath}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="仅显示与当前架构兼容的 Java；选择仅在本次运行生效。"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="刷新 Java 诊断" />
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="启动器 · 界面" />
                                <Label Content="主题模式" Target="{Binding #ThemeModeSelector}" />
                                <ComboBox x:Name="ThemeModeSelector"
                                          Width="240"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="主题模式"
                                          ItemsSource="{Binding ThemeModes}"
                                          SelectedItem="{Binding SelectedThemeMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding ThemeSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="主题偏好只保存在本机；不保存账户密码或令牌。语言、更新与反馈将在对应服务完成后启用。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="更多">
                <ScrollViewer>
                    <StackPanel Margin="28" MaxWidth="860" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="更多工具" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="联机、游戏目录、日志与维护工具。" />
                        </StackPanel>

                        <Border Padding="20" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏目录" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="在系统文件管理器中打开当前 Minecraft 根目录。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding MinecraftRootDirectory}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding OpenGameDirectoryCommand}" Content="打开游戏目录" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding GameDirectorySummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏日志" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding GameLogSummary}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ClearGameLogsCommand}"
                                        IsEnabled="{Binding HasGameLogLines}"
                                        Content="清除本次会话日志" />
                                <Border MaxHeight="260"
                                        Padding="12"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GameLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Menlo, Consolas, monospace"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Padding="20" CornerRadius="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="PCL 与 PCL-CE 归属说明" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="PCL Aurora 是基于 Plain Craft Launcher（PCL）及 PCL-CE 的第三方跨平台迁移与二次创作项目，并非官方项目。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="原作者：龙腾猫跃（成都瓜皮龙科技有限公司）· 赞助链接：https://meloong.com/afd/a/LTCat"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="直接适配内容及其分发遵循随附的上游许可证和 NOTICE；Micro-ATP 的新增内容适用根目录许可证。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
