            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderBrush" Value="#E0E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
            <Setter Property="Foreground" Value="#24415F" />
            <Setter Property="BorderBrush" Value="#C7DEF5" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:selected">
            <Setter Property="Background" Value="#DCEEFF" />
            <Setter Property="Foreground" Value="#0F5FCC" />
            <Setter Property="BorderBrush" Value="#83B8F8" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#D3E9FF" />
            <Setter Property="Foreground" Value="#0F5FCC" />
        </Style>
        <Style Selector="Border.official-version-row">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.official-version-row:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
        </Style>
        <Style Selector="Button.official-version-main">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0,74,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.official-version-main:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.official-version-main:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
        <Style Selector="Border.official-version-row:focus-within">
            <Setter Property="Background" Value="#E4F1FF" />
        </Style>
        <Style Selector="StackPanel.version-actions">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.official-version-row:pointerover StackPanel.version-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.official-version-row:focus-within StackPanel.version-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.version-row-action">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2C85E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.version-row-action:pointerover">
            <Setter Property="Background" Value="#D3E9FF" />
            <Setter Property="Foreground" Value="#1265C1" />
        </Style>
        <Style Selector="Border.version-category-card">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #16000000" />
        </Style>
        <Style Selector="Border.version-category-card:pointerover">
            <Setter Property="BoxShadow" Value="0 2 5 0 #240B5BCB" />
        </Style>
        <Style Selector="ToggleButton.version-category-header">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0,16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.version-category-header:pointerover">
            <Setter Property="Foreground" Value="#1370F3" />
            <Setter Property="Background" Value="#F8FBFE" />
        </Style>
        <Style Selector="ToggleButton.version-category-header:pressed">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.loader-directory-header">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0,16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.loader-directory-header:pointerover">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="Button.loader-directory-header:pressed">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.loader-package-main">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0,44,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.loader-package-main:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.loader-package-main:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
        <Style Selector="Button.version-component">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="Foreground" Value="#344150" />
            <Setter Property="BorderBrush" Value="#D1DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.version-component:pointerover">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="BorderBrush" Value="#9FC8EC" />
        </Style>
        <Style Selector="Button.version-detail-back">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7D8894" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.version-detail-back:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
            <Setter Property="Foreground" Value="#176FC5" />
        </Style>
        <Style Selector="Button.install-component-clear">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,5,32,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6F7C8B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.install-component-clear:pointerover">
            <Setter Property="Background" Value="#E4F1FF" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="Button.install-version-row">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#344150" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.install-version-row:pointerover">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="Button.install-version-row:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
    </Window.Styles>

    <Grid>
    <Border CornerRadius="8" ClipToBounds="True">
    <Grid Classes="pcl-shell" RowDefinitions="48,*">
        <Border x:Name="MainTitleBar" Background="#1370F3" PointerPressed="TitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="PCL Aurora" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LaunchNavigation" Classes="main-navigation selected" Tag="0" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadNavigation" Classes="main-navigation" Tag="1" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 15V3 M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="下载" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavigation" Classes="main-navigation" Tag="2" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreNavigation" Classes="main-navigation" Tag="3" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 3v18 M3 12h18 M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="更多" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="4"
                            HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Paths and 28 px sizing follow PCL2 FormMain.xaml title controls. -->
                    <Button Classes="window-control" Click="MinimizeWindowClick" ToolTip.Tip="最小化">
                        <Path Width="15" Height="2" Stretch="Fill" Fill="White"
                              Data="M0,0 h15 v2 h-15 v-2 Z" />
                    </Button>
                    <Button Classes="window-control" Click="CloseWindowClick" ToolTip.Tip="关闭">
                        <Path Width="14.4" Height="14.4" Stretch="Uniform" Fill="White"
                              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CommunityDetailTitleBar" Background="#1370F3"
                PointerPressed="TitleBarPointerPressed" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="community-detail-title-back" Click="CommunityResourceBackClick"
                        ToolTip.Tip="返回资源目录" AutomationProperties.Name="返回资源目录">
                    <Path Width="18" Height="18" Data="{StaticResource CommunityBackIcon}" Stretch="Uniform"
                          Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                </Button>
                <TextBlock x:Name="CommunityDetailTitleBarTitle" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                           Text="资源下载" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="4"
                            HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="window-control" Click="MinimizeWindowClick" ToolTip.Tip="最小化">
                        <Path Width="15" Height="2" Stretch="Fill" Fill="White"
                              Data="M0,0 h15 v2 h-15 v-2 Z" />
                    </Button>
                    <Button Classes="window-control" Click="CloseWindowClick" ToolTip.Tip="关闭">
                        <Path Width="14.4" Height="14.4" Stretch="Uniform" Fill="White"
                              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainPages" Grid.Row="1">
            <Grid x:Name="LaunchPage">
                <Grid ColumnDefinitions="300,*" Background="#D9EAF9">
                    <Border Background="#FCFCFD" BorderBrush="#D7DCE2" BorderThickness="0,0,1,0">
                        <Grid Margin="20,20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <!-- Icons reused from PCL2 PageLaunchLeft.xaml under the upstream project license. -->
                                <Button Classes="account-mode" Classes.selected="{Binding IsMicrosoftAccountMode}"
                                        Command="{Binding ShowMicrosoftAccountCommand}"
                                        ToolTip.Tip="{Binding MicrosoftLoginSummary}">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Width="18" Height="18" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" />
                                        <TextBlock Text="正版" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="account-mode" Classes.selected="{Binding IsOfflineAccountMode}"
                                        Command="{Binding ShowOfflineAccountCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Width="17" Height="17" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" />
                                        <TextBlock Text="离线" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="6">
                                <Border Classes="pcl-status-strip" Background="#E8F3FF">
                                    <TextBlock FontSize="12" Foreground="#2472C8" Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                                </Border>
                                <Border Classes="pcl-status-strip" Background="#FFF4D7" IsVisible="{Binding NeedsGameDownload}">
                                    <TextBlock FontSize="12" Foreground="#9A6A00" Text="尚未发现可用实例，请先下载或选择游戏版本" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <StackPanel IsVisible="{Binding IsOfflineAccountMode}" Spacing="12">
                                    <Border Width="56" Height="56" CornerRadius="3" HorizontalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Image Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="Fill" RenderOptions.BitmapInterpolationMode="None">
                                                <Image.Source>
                                                    <CroppedBitmap Source="/Assets/Skins/PclCeAlex.png" SourceRect="8,8,8,8" />
                                                </Image.Source>
                                            </Image>
                                            <Image Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="Fill" RenderOptions.BitmapInterpolationMode="None">
                                                <Image.Source>
                                                    <CroppedBitmap Source="/Assets/Skins/PclCeAlex.png" SourceRect="40,8,8,8" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Height="35" PlaceholderText="游戏用户名" Text="{Binding OfflinePlayerName}" />
                                        <Button Grid.Column="1" Height="35" MinWidth="76"
                                                Command="{Binding UseOfflineAccountCommand}" Content="使用" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsMicrosoftAccountMode}" Spacing="11">
                                    <Path Width="40" Height="40" HorizontalAlignment="Center" Stretch="Uniform"
                                          Fill="Transparent" Stroke="#6B7C8F" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding MicrosoftAccountDisplayName}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#6F7C8B"
                                                   Text="{Binding MicrosoftLoginSummary}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Height="34" MinWidth="96" Margin="4,0"
                                                    Command="{Binding StartMicrosoftLoginCommand}"
                                                    IsEnabled="{Binding CanStartMicrosoftLogin}" Content="登录" />
                                            <Button Height="32" MinWidth="76" Margin="4,0"
                                                    IsVisible="{Binding HasMicrosoftAccountProfile}"
                                                    Command="{Binding RestoreMicrosoftLoginCommand}"
                                                    IsEnabled="{Binding CanRestoreMicrosoftLogin}" Content="恢复登录" />
                                            <Button Height="32" MinWidth="76" Margin="4,0"
                                                    IsVisible="{Binding HasMicrosoftAccountProfile}"
                                                    Command="{Binding ClearMicrosoftLoginCommand}" Content="退出登录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Spacing="8">
                                <Button Classes="launch-action launch-download-button" Click="OpenDownloadPageClick"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding NeedsGameDownload}" Height="54" FontSize="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock HorizontalAlignment="Center" Text="下载游戏" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.65" Text="未找到可用的游戏版本" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="launch-action launch-button" Command="{Binding LaunchGameCommand}"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding HasAvailableInstances}"
                                        IsEnabled="{Binding CanLaunchGame}" Height="52" FontSize="16" Content="启动游戏" />
                                <Button Classes="launch-action launch-download-button" Click="OpenDownloadPageClick"
                                        HorizontalAlignment="Stretch"
                                        Height="35" FontSize="14" Content="版本选择" />
                            </StackPanel>
                            <ComboBox Grid.Row="4" x:Name="InstanceSelector"
                                      AutomationProperties.Name="启动实例"
                                      IsVisible="{Binding HasAvailableInstances}"
                                      ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="#6F7C8B"
                                                       Text="{Binding VersionDisplay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#D9EAF9">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,24,28,28" MaxWidth="520"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="14">
                                <!-- Direct Avalonia adaptation of PCL-CE PageLaunchRight's community notice card. -->
                                <Border Classes="pcl-notice" Padding="0">
                                    <Grid RowDefinitions="40,*">
                                        <TextBlock Margin="18,0" VerticalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#1370F3" Text="PCL Aurora 提示" />
                                        <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="#E2E8F0" />
                                        <StackPanel Grid.Row="1" Margin="18,14,18,17" Spacing="11">
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="你正在使用 PCL Aurora（PCL 跨平台版）！此版本为独立开发和维护，与原版维护路线不同，体验有所出入。" />
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="如果你是意外下载到了 PCL Aurora，我们十分建议您下载原版 PCL 长期使用，此发行版本对新手用户体验可能不友好。" />
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="此外，PCL Aurora 的问题请向 PCL Aurora 的仓库提交 Issue，不要向官方仓库反馈 PCL Aurora 的问题哦！" />

                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="pcl-notice" IsVisible="{Binding HasAvailableInstances}">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1370F3" Text="启动状态" />
                                        <TextBlock Text="{Binding GameLaunchSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding LaunchPreflightSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding VersionMetadataSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding JavaRequirementSummary}" TextWrapping="Wrap" />
                                        <CheckBox IsEnabled="{Binding RequiresAccountGuidance}"
                                                  IsChecked="{Binding HasAcknowledgedAccountGuidance}"
                                                  Content="我已知悉正版购买与上游赞助提示。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="DownloadPage" IsVisible="False">
                <Grid x:Name="DownloadPageLayout" Background="#D9EAF9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="178" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DownloadSidebar" Background="#FCFCFD" Padding="0,12,0,0"
                            BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Column names follow PCL2 PageDownloadLeft.xaml with PCL-CE installer additions. -->
                            <StackPanel x:Name="DownloadNavigationPanel" Spacing="2">
                                <Grid Classes="download-navigation-row selected" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation selected" Click="DownloadNavigationClick"
                                                                  Tag="game" Label="原版游戏"
                                                                  IconData="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7 12 12l8.7-5 M12 22V12" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="game" Click="DownloadSectionRefreshClick"
                                            ToolTip.Tip="刷新" AutomationProperties.Name="刷新原版游戏">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="社区资源" />
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="mod" Label="模组"
                                                                  IconData="M14.7 6.3 17.7 3.3 20.7 6.3 17.7 9.3 M14.7 6.3 4 17v3h3l10.7-10.7" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="mod" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新模组">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="pack" Label="整合包" IconData="M21 8v13H3V8 M1 3h22v5H1z M10 12h4" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="pack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新整合包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="datapack" Label="数据包" IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="datapack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新数据包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="resourcepack" Label="资源包" IconData="M12 2 2 7l10 5 10-5-10-5z M2 12l10 5 10-5 M2 17l10 5 10-5" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="resourcepack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新资源包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="shader" Label="光影包" IconData="M12 2v2 M12 20v2 M4.93 4.93l1.42 1.42 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M4.93 19.07l1.42-1.41 M17.66 6.34l1.41-1.41 M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="shader" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新光影包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="world" Label="世界" IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 0 20 M12 2a15.3 15.3 0 0 0 0 20" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="world" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新世界">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="favorites" Label="收藏夹" IconData="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="favorites" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新收藏夹">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="安装包" />
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="optifine" Label="OptiFine" IconData="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="optifine" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 OptiFine">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="forge" Label="Forge" IconData="M14.7 6.3 17.7 3.3 20.7 6.3 17.7 9.3 M14.7 6.3 4 17v3h3l10.7-10.7" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="forge" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Forge">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="neoforge" Label="NeoForge" IconData="M21 16V8l-9-5-9 5v8l9 5 9-5z M3.3 7 12 12l8.7-5 M12 22V12" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="neoforge" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 NeoForge">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="fabric" Label="Fabric" IconData="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5l6.74-6.76z M16 8 2 22 M17.5 15H9" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="fabric" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Fabric">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="cleanroom" Label="Cleanroom" IconData="M3 6h18 M7 6V4h10v2 M5 6l1 16h12l1-16 M9 10v8 M15 10v8" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="cleanroom" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Cleanroom">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="legacy-fabric" Label="Legacy Fabric" IconData="M12 2v20 M5 5h14 M5 19h14 M7 9h10 M7 15h10" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="legacy-fabric" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Legacy Fabric">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="labymod" Label="LabyMod" IconData="M4 4h16v16H4z M8 8v8h8" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="labymod" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 LabyMod">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="liteloader" Label="LiteLoader" IconData="M13 2 3 14h9l-1 8 10-12h-9z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="liteloader" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 LiteLoader">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="DownloadContentScroller" Grid.Column="1" Background="#D9EAF9" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="25,10,25,25" MaxWidth="860" Spacing="15">
                            <!-- PCL2 PageDownloadClient/PageDownloadInstall structure adapted to Aurora's existing commands. -->
                            <StackPanel x:Name="DownloadGameView" MinHeight="430" Spacing="15">
                                <StackPanel IsVisible="{Binding !IsVersionCatalogLoading}" Spacing="15">
                                    <Border Classes="version-category-card" Padding="12,8,12,12">
                                        <StackPanel>
                                            <TextBlock Margin="3,0,0,5" FontSize="13" FontWeight="Bold" Text="最新版本" />
                                            <ContentControl Content="{Binding LatestReleaseVersion}"
                                                            ContentTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                            <ContentControl Content="{Binding LatestSnapshotVersion}"
                                                            ContentTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="ReleaseVersionToggle" Classes="version-category-header" Tag="release"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding ReleaseVersions.Count, StringFormat=正式版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=ReleaseVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=ReleaseVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="ReleaseVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=ReleaseVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="SnapshotVersionToggle" Classes="version-category-header" Tag="snapshot"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding SnapshotVersions.Count, StringFormat=预览版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=SnapshotVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=SnapshotVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="SnapshotVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=SnapshotVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="LegacyVersionToggle" Classes="version-category-header" Tag="legacy"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding LegacyVersions.Count, StringFormat=远古版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=LegacyVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=LegacyVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="LegacyVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=LegacyVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="AprilFoolsVersionToggle" Classes="version-category-header" Tag="april-fools"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding AprilFoolsVersions.Count, StringFormat=愚人节版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=AprilFoolsVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=AprilFoolsVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="AprilFoolsVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=AprilFoolsVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Classes="download-loading-card" Margin="0,38,0,38"
                                        IsVisible="{Binding IsVersionCatalogLoading}">
                                    <controls:PclLoadingIndicator Text="正在获取版本列表" />
                                </Border>
                            </StackPanel>

                            <!-- Direct Avalonia adaptation of PCL-CE PageDownloadInstall's component selection page. -->
                            <StackPanel x:Name="DownloadCombinedInstallView" IsVisible="False" MinHeight="430" Spacing="12">
                                <Border Classes="version-category-card" Height="62" Margin="0,15,0,3">
                                    <Grid ColumnDefinitions="42,40,*" Margin="10,0,16,0">
                                        <Button Classes="version-detail-back" Click="CombinedInstallBackClick"
                                                ToolTip.Tip="返回版本列表" AutomationProperties.Name="返回版本列表">
                                            <Path Width="18" Height="18" Data="M19 12H5 M12 19l-7-7 7-7"
                                                  Stretch="Uniform" Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Button>
                                        <Image Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center"
                                               Source="{Binding SelectedCatalogVersion, Converter={StaticResource MinecraftVersionIconConverter}}" />
                                        <StackPanel Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CombinedInstallationName}" />
                                            <TextBlock FontSize="11" Foreground="#7D8894"
                                                       Text="{Binding SelectedCatalogVersion.Id, StringFormat=Minecraft {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,32,0,32"
                                        IsVisible="{Binding IsCombinedInstallerLoading}">
                                    <controls:PclLoadingIndicator Text="正在获取可选组件" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding CombinedInstallComponents}"
                                              IsVisible="{Binding !IsCombinedInstallerLoading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MinecraftInstallComponentViewModel">
                                            <Border Classes="version-category-card" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <ToggleButton Classes="version-category-header"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanExpand}">
                                                            <Grid ColumnDefinitions="110,22,*,20" ColumnSpacing="7">
                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                           Text="{Binding DisplayName}" />
                                                                <Image Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center"
                                                                       Stretch="Uniform" Source="{Binding IconPath}"
                                                                       IsVisible="{Binding HasSelection}" />
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#6F7C8B"
                                                                           TextTrimming="CharacterEllipsis" Text="{Binding HeaderSummary}" />
                                                                <Grid Grid.Column="3" Width="18" Height="18" IsVisible="{Binding CanExpand}">
                                                                    <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}"
                                                                          Stretch="Uniform" Fill="Transparent" Stroke="#6F7C8B"
                                                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          IsVisible="{Binding !IsExpanded}" />
                                                                    <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}"
                                                                          Stretch="Uniform" Fill="Transparent" Stroke="#1370F3"
                                                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          IsVisible="{Binding IsExpanded}" />
                                                                </Grid>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <Button Classes="install-component-clear" Tag="{Binding Kind}"
                                                                Click="CombinedInstallComponentClearClick"
                                                                IsVisible="{Binding HasSelection}"
                                                                ToolTip.Tip="清除所选版本"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=清除所选 {0}}">
                                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                                                        </Button>
                                                    </Grid>
                                                    <ItemsControl Margin="20,0,18,15" ItemsSource="{Binding Versions}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="domain:MinecraftLoaderCatalogEntry">
                                                                <Button Classes="install-version-row" Tag="{Binding}"
                                                                        Click="CombinedInstallComponentVersionClick"
                                                                        AutomationProperties.Name="{Binding Version, StringFormat=选择版本 {0}}">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Version}" />
                                                                            <TextBlock FontSize="11" Foreground="#89939E"
                                                                                       Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                                                   Foreground="#6F7C8B" Text="{Binding Channel}" />
                                                                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="6,2"
                                                                                CornerRadius="2" Background="#E8F7EE"
                                                                                IsVisible="{Binding IsRecommended}">
                                                                            <TextBlock FontSize="11" Foreground="#287A49" Text="推荐" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Classes="version-category-card" Padding="16,13" Margin="0,3,0,15"
                                        IsVisible="{Binding !IsCombinedInstallerLoading}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock VerticalAlignment="Center" Foreground="#5F6C79" TextWrapping="Wrap"
                                                   Text="{Binding CombinedInstallationSummary}" />
                                        <Button Grid.Column="1" Classes="download-primary" MinWidth="112"
                                                Click="CombinedInstallStartClick"
                                                IsEnabled="{Binding CanStartCombinedInstallation}"
                                                Content="开始安装" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Direct Avalonia adaptation of PCL-CE's independent installer directories. -->
                            <StackPanel x:Name="DownloadLoaderView" IsVisible="False" MinHeight="430" Spacing="15">
                                <Border Classes="pcl-card" Padding="18">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="DownloadLoaderIntroTitle" FontSize="16" FontWeight="SemiBold" Text="Forge 简介" />
                                        <TextBlock x:Name="DownloadLoaderIntroDescription" Foreground="#5F6C79" TextWrapping="Wrap"
                                                   Text="Forge 是一个模组加载器，你需要先安装 Forge 才能安装各种 Forge 模组。" />
                                        <Button x:Name="DownloadLoaderWebsiteButton" Classes="download-primary"
                                                MinWidth="140" Height="35" HorizontalAlignment="Left"
                                                Click="LoaderWebsiteClick" Content="打开官方网站" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,38,0,38"
                                        IsVisible="{Binding IsLoaderPageLoading}">
                                    <controls:PclLoadingIndicator x:Name="LoaderCatalogLoadingIndicator"
                                                                  Text="正在获取 Forge 列表…" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding LoaderDirectoryGroups}"
                                              IsVisible="{Binding !IsLoaderPageLoading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MinecraftLoaderDirectoryGroupViewModel">
                                            <Border Classes="version-category-card" Margin="0,0,0,15">
                                                <StackPanel>
                                                    <Button Classes="loader-directory-header" Tag="{Binding}"
                                                            Click="LoaderDirectoryGroupClick"
                                                            IsVisible="{Binding IsCollapsible}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=展开 {0}}">
                                                        <Grid ColumnDefinitions="*,20">
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                       Text="{Binding Title}" />
                                                            <Grid Grid.Column="1" Width="18" Height="18">
                                                                <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}"
                                                                      Stretch="Uniform" Fill="Transparent" Stroke="#6F7C8B"
                                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      IsVisible="{Binding !IsExpanded}" />
                                                                <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}"
                                                                      Stretch="Uniform" Fill="Transparent" Stroke="#1370F3"
                                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      IsVisible="{Binding IsExpanded}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                    <Grid Height="40" Margin="15,0,16,0" IsVisible="{Binding !IsCollapsible}">
                                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                   Text="{Binding Title}" />
                                                    </Grid>
                                                    <Border Classes="download-loading-card" Margin="18,4,18,14"
                                                            IsVisible="{Binding IsLoading}">
                                                        <controls:PclLoadingIndicator Text="{Binding StatusText}" />
                                                    </Border>
                                                    <TextBlock Margin="20,4,18,14" Foreground="#A44343" TextWrapping="Wrap"
                                                               IsVisible="{Binding HasError}"
                                                               Text="{Binding Error}" />
                                                    <ItemsControl Margin="12,0,12,12" ItemsSource="{Binding Entries}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MinecraftLoaderPackageItemViewModel">
                                                                <Border Classes="official-version-row">
                                                                    <Grid>
                                                                        <Button Classes="loader-package-main" Tag="{Binding}"
                                                                                Click="LoaderPackageDownloadClick"
                                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=下载 {0}}">
                                                                            <Grid ColumnDefinitions="34,*" ColumnSpacing="8">
                                                                                <Image Width="30" Height="30" VerticalAlignment="Center"
                                                                                       Stretch="Uniform"
                                                                                       Source="{Binding Kind, Converter={StaticResource MinecraftLoaderIconConverter}}" />
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <TextBlock FontSize="14" Text="{Binding DisplayName}" />
                                                                                        <TextBlock FontSize="11" Foreground="#287A49"
                                                                                                   VerticalAlignment="Center" IsVisible="{Binding IsRecommended}"
                                                                                                   Text="推荐" />
                                                                                    </StackPanel>
                                                                                    <TextBlock FontSize="11" Foreground="#88929D"
                                                                                               Text="{Binding Information}" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Button>
                                                                        <StackPanel Classes="version-actions" Margin="0,0,6,0"
                                                                                    Orientation="Horizontal" HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Center" Spacing="1">
                                                                            <Button Classes="version-row-action" Tag="{Binding}"
                                                                                    Click="LoaderPackageChangelogClick"
                                                                                    IsVisible="{Binding HasChangelog}"
                                                                                    ToolTip.Tip="更新日志" AutomationProperties.Name="查看更新日志">
                                                                                <Path Width="18" Height="18" Data="{StaticResource VersionInfoIcon}"
                                                                                      Stretch="Uniform" Fill="Transparent"
                                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="5,0" Foreground="#A44343" TextWrapping="Wrap"
                                           IsVisible="{Binding HasLoaderDirectorySummary}"
                                           Text="{Binding LoaderDirectorySummary}" />

                            </StackPanel>

                            <!-- Search structure directly adapts PCL2 PageResource and PCL-CE PageComp.
                                 Aurora uses Avalonia bindings and credential-free public catalogs. -->
                            <StackPanel x:Name="DownloadCommunityCard" MinHeight="430" Spacing="12" IsVisible="False">
                                <StackPanel x:Name="DownloadCommunityCatalogView" Spacing="12">
                                <StackPanel IsVisible="{Binding IsCommunityFavoritesPage}" Spacing="15">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                        <Border Classes="pcl-card" Padding="10,7"
                                                IsVisible="{Binding IsCommunityFavoriteSearchVisible}">
                                            <Grid Height="34" ColumnDefinitions="24,*" ColumnSpacing="8">
                                                <Path Width="18" Height="18" VerticalAlignment="Center"
                                                      Data="M21 21l-4.35-4.35 M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16"
                                                      Fill="Transparent" Stroke="#36424F" StrokeThickness="2"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                                <TextBox Grid.Column="1" Classes="community-search-input"
                                                         PlaceholderText="在当前收藏夹中搜索"
                                                         Text="{Binding CommunityFavoriteSearchText}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Classes="pcl-card" Height="48" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ComboBox MinWidth="96" MaxWidth="180" VerticalAlignment="Center"
                                                          ItemsSource="{Binding CommunityFavoriteFolders}"
                                                          SelectedItem="{Binding SelectedCommunityFavoriteFolder}"
                                                          SelectionChanged="CommunityFavoriteFolderSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="domain:CommunityFavoriteFolder">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Classes="community-row-action" Width="34" Height="34"
                                                        Click="CommunityFavoriteManageClick" ToolTip.Tip="管理收藏夹"
                                                        AutomationProperties.Name="管理收藏夹">
                                                    <Path Width="17" Height="17"
                                                          Data="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.14.37.2.75.2 1.1s.2.73.6 1c.3.2.68.4 1.1.4H21a2 2 0 1 1 0 4h-.09c-.42 0-.8.2-1.1.5-.2.3-.4.68-.4 1z"
                                                          Stretch="Uniform" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding CommunityFavoriteGroups}"
                                                  IsVisible="{Binding IsCommunityFavoriteListVisible}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommunityFavoriteGroupViewModel">
                                                <Border Classes="version-category-card" Margin="0,0,0,15" Padding="12,8,12,12">
                                                    <StackPanel>
                                                        <TextBlock Margin="3,0,0,5" FontSize="13" FontWeight="Bold"
                                                                   Text="{Binding Title, StringFormat={}{0}}" />
                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                      ItemTemplate="{StaticResource CommunityProjectRowTemplate}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Classes="pcl-card" Width="560" MaxWidth="720" Padding="24,18"
                                            Margin="40,80" HorizontalAlignment="Center"
                                            IsVisible="{Binding IsCommunityFavoriteEmptyVisible}">
                                        <StackPanel>
                                            <TextBlock HorizontalAlignment="Center" FontSize="19" Foreground="#2780DF"
                                                       Text="{Binding CommunityFavoriteEmptyTitle}" />
                                            <Border Height="2" Margin="0,10,0,15" Background="#2780DF" />
                                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                                                       Text="{Binding CommunityFavoriteEmptyDescription}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Classes="pcl-card" Padding="10,7"
                                        IsVisible="{Binding IsCommunityCatalogAvailable}">
                                    <Grid Height="34" ColumnDefinitions="24,*,88" ColumnSpacing="8">
                                        <Path Width="18" Height="18" VerticalAlignment="Center"
                                              Data="M21 21l-4.35-4.35 M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16"
                                              Fill="Transparent" Stroke="#36424F" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBox Grid.Column="1" Classes="community-search-input"
                                                 PlaceholderText="搜索资源"
                                                 Text="{Binding CommunitySearchText}" />
                                        <Button Grid.Column="2" Classes="community-action-primary"
                                                Height="34" MinWidth="88"
                                                Command="{Binding SearchCommunityResourcesCommand}"
                                                Content="搜索" />
                                    </Grid>
                                </Border>

                                <Border Classes="pcl-card" Padding="14"
                                        IsVisible="{Binding IsCommunityCatalogAvailable}">
                                    <Grid ColumnDefinitions="Auto,1*,Auto,1.3*,Auto,1*,Auto"
                                          RowDefinitions="30,10,30" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" Text="来源" />
                                        <ComboBox Grid.Column="1" Classes="community-filter" SelectedIndex="0">
                                            <ComboBoxItem Content="全部" />
                                        </ComboBox>

                                        <TextBlock Grid.Column="2" Margin="0,0,2,0" VerticalAlignment="Center" Text="标签" />
                                        <ComboBox Grid.Column="3" Classes="community-filter"
                                                  ItemsSource="{Binding CommunityResourceCategoryOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceCategory}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceCategoryOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="4" Margin="0,0,2,0" VerticalAlignment="Center" Text="排序方式" />
                                        <ComboBox Grid.Column="5" Classes="community-filter"
                                                  ItemsSource="{Binding CommunityResourceSortOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceSort}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceSortOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" Text="版本" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Height="30"
                                                 PlaceholderText="全部（也可自行输入）"
                                                 Text="{Binding CommunityGameVersion}" />

                                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,2,0" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCommunityLoaderFilterVisible}" Text="加载器" />
                                        <ComboBox Grid.Row="2" Grid.Column="3" Classes="community-filter"
                                                  IsVisible="{Binding IsCommunityLoaderFilterVisible}"
                                                  ItemsSource="{Binding CommunityResourceLoaderOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceLoader}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceLoaderOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Classes="pcl-status-strip" Background="#EDF6FF"
                                        IsVisible="{Binding IsCommunityStatusVisible}">
                                    <TextBlock FontSize="12" Foreground="#365879"
                                               Text="{Binding CommunityResourceSummary}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,41,0,41"
                                        IsVisible="{Binding IsCommunitySearchRunning}">
                                    <controls:PclLoadingIndicator Text="{Binding CommunityLoadingText}" />
                                </Border>

                                <Border Classes="pcl-card" Padding="12" IsVisible="{Binding IsCommunityResultListVisible}">
                                    <ItemsControl ItemsSource="{Binding CommunityResources}"
                                                  ItemTemplate="{StaticResource CommunityProjectRowTemplate}" />
                                </Border>

                                <Border Classes="pcl-card" Padding="12"
                                        IsVisible="{Binding IsCommunityFooterVisible}">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <Button MinWidth="72" Command="{Binding PreviousCommunityPageCommand}"
                                                    IsEnabled="{Binding CanGoToPreviousCommunityPage}" Content="上一页" />
                                            <Border MinWidth="42" Background="#EDF6FF" CornerRadius="3" Padding="10,7">
                                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                                           Text="{Binding CommunityPageNumber}" />
                                            </Border>
                                            <Button MinWidth="72" Command="{Binding NextCommunityPageCommand}"
                                                    IsEnabled="{Binding CanGoToNextCommunityPage}" Content="下一页" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <StackPanel x:Name="DownloadCommunityDetailView" IsVisible="False" Spacing="15">
                                    <Border Classes="pcl-card community-detail-card" Padding="12,10">
                                        <StackPanel Spacing="7">
                                            <ContentControl Content="{Binding SelectedCommunityResource}"
                                                            ContentTemplate="{StaticResource CommunityProjectRowTemplate}"
                                                            IsHitTestVisible="False" />

                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Command="{Binding OpenCommunityResourceCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Text="{Binding SelectedCommunityResource.Project.SourceDisplay}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Click="CommunityResourceCopyNameClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityCopyIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="复制名称" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Click="CommunityResourceCopyLinkClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityCopyIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="复制链接" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Command="{Binding TranslateCommunityDescriptionCommand}"
                                                        IsEnabled="{Binding CanTranslateCommunityDescription}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="翻译简介" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Tag="{Binding SelectedCommunityResource}"
                                                        Click="CommunityResourceFavoriteClick"
                                                        IsVisible="{Binding !SelectedCommunityResource.IsFavorite}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="收藏" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Tag="{Binding SelectedCommunityResource}"
                                                        Click="CommunityResourceFavoriteClick"
                                                        IsVisible="{Binding SelectedCommunityResource.IsFavorite}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="已收藏" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <Border Padding="12,10" Background="#F3F8FD" CornerRadius="4"
                                                    IsVisible="{Binding IsCommunityDescriptionTranslationPanelVisible}">
                                                <Grid MinHeight="70">
                                                    <controls:PclLoadingIndicator
                                                        IsVisible="{Binding IsCommunityDescriptionTranslationRunning}"
                                                        Text="正在获取简介译文" />
                                                    <StackPanel IsVisible="{Binding !IsCommunityDescriptionTranslationRunning}"
                                                                Spacing="8">
                                                        <TextBlock Foreground="#52708C"
                                                                   Text="{Binding CommunityDescriptionTranslationSummary}"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Spacing="3">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#798692" Text="原文" />
                                                            <TextBlock Foreground="#4E5D6B"
                                                                       Text="{Binding SelectedCommunityResource.Project.Description}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="3"
                                                                    IsVisible="{Binding HasCommunityDescriptionTranslation}">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2472C8" Text="译文" />
                                                            <TextBlock Foreground="#364E64"
                                                                       Text="{Binding CommunityDescriptionTranslation}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="download-loading-card" Margin="0,35,0,35"
                                            IsVisible="{Binding IsCommunityVersionLoading}">
                                        <controls:PclLoadingIndicator Text="正在获取版本列表" />
                                    </Border>

                                    <Border Classes="pcl-card community-detail-card" Padding="0"
                                            IsVisible="{Binding IsCommunityVersionFilterVisible}">
                                        <StackPanel>
                                            <Grid Margin="10,10,10,5" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                                  IsVisible="{Binding IsCommunityGameVersionFilterVisible}">
                                                <TextBlock Margin="2,4,0,0" VerticalAlignment="Top"
                                                           FontSize="13" Foreground="#343D4A" Text="实例筛选：" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CommunityGameVersionFilters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CommunityResourceVersionFilterOption">
                                                            <RadioButton Classes="community-version-filter"
                                                                         GroupName="CommunityGameVersionFilter"
                                                                         Tag="{Binding}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         Click="CommunityVersionGameFilterClick"
                                                                         AutomationProperties.Name="{Binding DisplayName, StringFormat=筛选游戏版本 {0}}"
                                                                         Content="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <Grid Margin="10,5,10,10" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                                  IsVisible="{Binding IsCommunityLoaderVersionFilterVisible}">
                                                <TextBlock Margin="2,4,0,0" VerticalAlignment="Top"
                                                           FontSize="13" Foreground="#343D4A" Text="模组加载器筛选：" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CommunityLoaderVersionFilters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CommunityResourceVersionFilterOption">
                                                            <RadioButton Classes="community-version-filter"
                                                                         GroupName="CommunityLoaderVersionFilter"
                                                                         Tag="{Binding}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         Click="CommunityVersionLoaderFilterClick"
                                                                         AutomationProperties.Name="{Binding DisplayName, StringFormat=筛选加载器 {0}}"
                                                                         Content="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding CommunityResourceVersionGroups}"
                                                  IsVisible="{Binding HasCommunityResourceVersions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommunityResourceVersionGroupViewModel">
                                                <Border Classes="version-category-card" Margin="0,0,0,15">
                                                    <StackPanel>
                                                        <ToggleButton Classes="community-version-group-toggle"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                           Text="{Binding Title, StringFormat={}{0}}" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Grid Width="18" Height="18">
                                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform"
                                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                              IsVisible="{Binding !IsExpanded}" />
                                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform"
                                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                              IsVisible="{Binding IsExpanded}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <ItemsControl Margin="12,0,12,10" ItemsSource="{Binding Versions}"
                                                                      IsVisible="{Binding IsExpanded}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="domain:CommunityResourceVersion">
                                                                    <Border MinHeight="58" Padding="5,6" BorderBrush="#E7EDF3" BorderThickness="0,0,0,1">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding VersionNumber}" />
                                                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#6F7C8B"
                                                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                                <TextBlock FontSize="11" Foreground="#526170"
                                                                                           Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" MinWidth="92" VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Right" Spacing="2">
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#1370F3"
                                                                                           Text="{Binding ChannelDisplay}" />
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#526170"
                                                                                           Text="{Binding LoaderSummary}" />
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#6F7C8B"
                                                                                           Text="{Binding PublishedAtDisplay}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="2" Classes="community-version-install" Tag="{Binding}"
                                                                                    VerticalAlignment="Center" Click="CommunityVersionDownloadClick"
                                                                                    AutomationProperties.Name="{Binding VersionNumber, StringFormat=下载 {0}}"
                                                                                    Content="下载" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Classes="pcl-status-strip" Background="#EDF6FF"
                                            IsVisible="{Binding !HasCommunityResourceVersions}">
                                        <TextBlock FontSize="12" Foreground="#365879"
                                                   Text="{Binding CommunityVersionSummary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="DownloadDeferredCard" Classes="pcl-card" Padding="20" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="DownloadDeferredTitle" FontSize="17" FontWeight="SemiBold" Text="安装包" />
                                    <TextBlock Foreground="#6F7C8B" Text="暂未开放" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" IsVisible="False">
                <Grid ColumnDefinitions="152,*" Background="#D9EAF9">
                    <Border Background="#FCFCFD" Padding="0,12,0,0" BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Category structure follows PCL-CE PageSetupLeft.xaml; visual treatment follows PCL2. -->
                            <StackPanel x:Name="SettingsNavigationPanel" Spacing="2">
                                <TextBlock Margin="13,0,5,3" FontSize="12" Foreground="#6F7C8B" Text="游戏" />
                                <controls:PclNavigationButton Classes="secondary-navigation selected" Click="SettingsNavigationClick" Tag="launch" Label="启动"
                                                              IconData="M5 5a2 2 0 0 1 3-1.73l12 7a2 2 0 0 1 0 3.46l-12 7A2 2 0 0 1 5 19z" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="java" Label="Java"
                                                              IconData="M8 2h8 M9 2v5a3 3 0 0 0 6 0V2 M7 12h10v3a5 5 0 0 1-10 0z M5 22h14" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="manage" Label="管理"
                                                              IconData="M4 4h16v16H4z M4 9h16 M9 9v11" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="工具" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="link" Label="联机"
                                                              IconData="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="启动器" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="interface" Label="个性化"
                                                              IconData="M12 22a10 10 0 1 0 0-20 7 7 0 0 0 0 14h1.5a2.5 2.5 0 0 1 0 5z M7.5 10h.01 M12 7h.01 M16.5 10h.01" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="language" Label="语言"
                                                              IconData="M5 8l6 6 M4 14l6-7 2-3 M2 5h12 M12 22l4-9 4 9 M14 18h4" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="misc" Label="杂项"
                                                              IconData="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="关于" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="about" Label="软件信息"
                                                              IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="update" Label="软件更新"
                                                              IconData="M21 12a9 9 0 1 1-3-6.7 M21 3v6h-6" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="feedback" Label="反馈"
                                                              IconData="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="log" Label="查看日志"
                                                              IconData="M4 2h16v20H4z M8 7h8 M8 11h8 M8 15h5" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Column="1" Background="#D9EAF9">
                    <StackPanel Margin="25,25,25,10" MaxWidth="860" Spacing="15">

                        <StackPanel x:Name="SettingsLaunchSection" Spacing="15">
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1370F3" Text="启动" />
                                <TextBlock Foreground="#6F7C8B" Text="配置游戏运行环境、窗口、内存与下载行为。" />
                            </StackPanel>

                            <Border Classes="pcl-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Java 与运行环境" />
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="10">
                                        <TextBlock Text="当前平台" />
                                        <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="系统架构" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                                        <TextBlock Grid.Row="2" Text="Java 状态" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JavaSummary}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="启动 Java" />
                                        <ComboBox x:Name="JavaSelector" Grid.Column="1"
                                                  AutomationProperties.Name="启动 Java"
                                                  IsEnabled="{Binding HasAvailableJavaInstallations}"
                                                  ItemsSource="{Binding AvailableJavaInstallations}"
                                                  SelectedItem="{Binding SelectedJava}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                        <TextBlock Grid.Column="1" Foreground="#6F7C8B" Text="{Binding Vendor}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="150,*">
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                            <Button Command="{Binding RefreshCommand}" Content="重新搜索" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6F7C8B"
                                                       Text="仅显示与当前架构兼容的 Java" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="pcl-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="游戏启动" />
                                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="10" RowSpacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="窗口模式" />
                                        <ComboBox x:Name="GameWindowModeSelector" Grid.Column="1"
                                                  AutomationProperties.Name="Minecraft 窗口模式"
                                                  ItemsSource="{Binding GameWindowModes}"
                                                  SelectedItem="{Binding SelectedGameWindowMode}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="窗口尺寸" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" IsEnabled="{Binding UsesCustomGameWindowSize}" Orientation="Horizontal" Spacing="8">
                                            <TextBox Width="90" AutomationProperties.Name="自定义 Minecraft 窗口宽度" Text="{Binding CustomGameWindowWidth}" />
                                            <TextBlock VerticalAlignment="Center" Text="×" />
                                            <TextBox Width="90" AutomationProperties.Name="自定义 Minecraft 窗口高度" Text="{Binding CustomGameWindowHeight}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="内存分配" />
                                        <ComboBox x:Name="MemoryAllocationModeSelector" Grid.Row="2" Grid.Column="1"
                                                  AutomationProperties.Name="Minecraft 内存分配模式"
                                                  ItemsSource="{Binding MemoryAllocationModes}"
                                                  SelectedItem="{Binding SelectedMemoryAllocationMode}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="自定义内存" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" IsEnabled="{Binding UsesCustomMemoryAllocation}" Orientation="Horizontal" Spacing="8">
                                            <TextBox Width="120" AutomationProperties.Name="自定义 Minecraft 堆内存（MiB）" Text="{Binding CustomMemoryMiB}" />
                                            <TextBlock VerticalAlignment="Center" Text="MiB" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,8,0,0" Text="额外 JVM 参数" />
                                        <TextBox Grid.Row="4" Grid.Column="1" AcceptsReturn="True" Height="66" MaxLength="4000"
                                                 PlaceholderText="例如：-Xmx4G -Dexample=value" Text="{Binding AdditionalJvmArguments}"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                        <TextBlock Grid.Row="5" VerticalAlignment="Top" Margin="0,8,0,0" Text="额外游戏参数" />
                                        <TextBox Grid.Row="5" Grid.Column="1" AcceptsReturn="True" Height="66" MaxLength="4000"
                                                 PlaceholderText="例如：--demo" Text="{Binding AdditionalGameArguments}"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Button Command="{Binding SaveLaunchOptionsCommand}" Content="保存启动选项" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#6F7C8B"
                                                   Text="{Binding LaunchOptionsSummary}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="pcl-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="下载设置" />
                                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                        <TextBlock VerticalAlignment="Center" Text="最大下载连接数" />
                                        <ComboBox x:Name="DownloadConcurrencySelector" Grid.Column="1"
                                                  AutomationProperties.Name="最大下载连接数"
                                                  ItemsSource="{Binding DownloadConcurrencyOptions}"
                                                  SelectedItem="{Binding SelectedDownloadConcurrency}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="总下载限速" />
                                        <ComboBox x:Name="DownloadSpeedSelector" Grid.Row="1" Grid.Column="1"
                                                  AutomationProperties.Name="总下载限速"
                                                  ItemsSource="{Binding DownloadSpeedOptions}"
                                                  SelectedItem="{Binding SelectedDownloadSpeedLimit}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="#6F7C8B" Text="{Binding DownloadSettingsSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="SettingsJavaSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="Java" />
                                <TextBlock Foreground="#6F7C8B" Text="管理当前平台检测到的 Java 运行环境。" />
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="10">
                                    <TextBlock Text="操作系统" />
                                    <TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" />
                                    <TextBlock Grid.Row="1" Text="系统架构" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                                    <TextBlock Grid.Row="2" Text=".NET 运行时" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" />
                                    <TextBlock Grid.Row="3" Text="Java 状态" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding JavaSummary}" TextWrapping="Wrap" />
                                </Grid>
                                <Label Content="启动 Java" Target="{Binding #SettingsJavaSelector}" />
                                <ComboBox x:Name="SettingsJavaSelector" MinWidth="360" HorizontalAlignment="Left"
                                          IsEnabled="{Binding HasAvailableJavaInstallations}"
                                          ItemsSource="{Binding AvailableJavaInstallations}"
                                          SelectedItem="{Binding SelectedJava}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                <TextBlock Foreground="#6F7C8B" Text="{Binding Vendor}" />
                                                <TextBlock FontSize="11" Foreground="#6F7C8B" Text="{Binding ExecutablePath}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding RefreshCommand}" Content="重新搜索" />
                                    <Button IsEnabled="False" Content="手动导入" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsInterfaceSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="个性化" />
                                <Label Content="主题模式" Target="{Binding #ThemeModeSelector}" />
                                <ComboBox x:Name="ThemeModeSelector"
                                          Width="240"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="主题模式"
                                          ItemsSource="{Binding ThemeModes}"
                                          SelectedItem="{Binding SelectedThemeMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding ThemeSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="主题偏好只保存在本机；不保存账户密码或令牌。更新入口位于“更多 → 关于与鸣谢”。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsPlaceholderSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="SettingsPlaceholderTitle" FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="设置" />
                                <TextBlock x:Name="SettingsPlaceholderDescription" Foreground="#6F7C8B" TextWrapping="Wrap" />
                                <Border Background="#F8FAFC" BorderBrush="#D1DDEA" BorderThickness="1" CornerRadius="3" Padding="16">
                                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                        <TextBlock x:Name="SettingsPlaceholderLabel1" VerticalAlignment="Center" />
                                        <ComboBox x:Name="SettingsPlaceholderOption1" Grid.Column="1" IsEnabled="False" />
                                        <TextBlock x:Name="SettingsPlaceholderLabel2" Grid.Row="1" VerticalAlignment="Center" />
                                        <ComboBox x:Name="SettingsPlaceholderOption2" Grid.Row="1" Grid.Column="1" IsEnabled="False" />
                                        <TextBlock x:Name="SettingsPlaceholderLabel3" Grid.Row="2" VerticalAlignment="Center" />
                                        <ComboBox x:Name="SettingsPlaceholderOption3" Grid.Row="2" Grid.Column="1" IsEnabled="False" />
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button IsEnabled="False" Content="保存设置" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6F7C8B" Text="页面结构已完成，设置写入将在后续迁移阶段启用。" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="MorePage" IsVisible="False">
                <Grid ColumnDefinitions="152,*" Background="#D9EAF9">
                    <Border Background="#FCFCFD" Padding="0,12,0,0" BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <!-- PCL2 PageOtherLeft.xaml structure, plus PCL-CE/Aurora session log access. -->
                        <StackPanel x:Name="MoreNavigationPanel" Spacing="2">
                            <controls:PclNavigationButton Classes="secondary-navigation selected" Click="MoreNavigationClick" Tag="help" Label="帮助"
                                                          IconData="M9.1 9a3 3 0 1 1 5.83 1c0 2-3 2-3 4 M12 18h.01 M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="about" Label="关于与鸣谢"
                                                          IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="toolbox" Label="百宝箱"
                                                          IconData="M3 6h18v14H3z M8 6V4h8v2 M3 11h18 M10 11v3h4v-3" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="feedback" Label="反馈"
                                                          IconData="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="vote" Label="新功能投票"
                                                          IconData="M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                            <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="诊断" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="logs" Label="查看日志"
                                                          IconData="M4 2h16v20H4z M8 7h8 M8 11h8 M8 15h5" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" Background="#D9EAF9">
                    <StackPanel Margin="25,25,25,10" MaxWidth="860" Spacing="15">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="MorePageTitle" FontSize="20" FontWeight="SemiBold" Foreground="#1370F3" Text="帮助" />
                            <TextBlock x:Name="MorePageDescription" Foreground="#6F7C8B"
                                       Text="查看启动、下载、实例与故障排查入口。" />
                        </StackPanel>

                        <Border x:Name="MoreDirectorySection" Classes="pcl-card" Padding="20" Background="#FCFDFF" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="百宝箱" />
                                <TextBlock Foreground="#6F7C8B" Text="常用目录与跨平台维护工具。" />
                                <Separator />
                                <TextBlock FontWeight="SemiBold" Text="游戏目录" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="在系统文件管理器中打开当前 Minecraft 根目录。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding MinecraftRootDirectory}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding OpenGameDirectoryCommand}" Content="打开游戏目录" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding GameDirectorySummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreLogSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏日志" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding GameLogSummary}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ClearGameLogsCommand}"
                                        IsEnabled="{Binding HasGameLogLines}"
                                        Content="清除本次会话日志" />
                                <Border MaxHeight="260"
                                        Padding="12"
                                        Background="#FCFDFF"
                                        CornerRadius="8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GameLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Menlo, Consolas, monospace"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreAboutSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="PCL Aurora" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="当前发行、更新说明与安装包均由 PCL Aurora 的 GitHub Releases 提供。"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding OpenAuroraReleasesCommand}"
                                        Content="获取 PCL Aurora 最新版本" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding AuroraReleaseSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="PCL 与 PCL-CE 归属说明" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="PCL Aurora 是基于 Plain Craft Launcher（PCL）及 PCL-CE 的第三方跨平台迁移与二次创作项目，并非官方项目。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="原作者：龙腾猫跃（成都瓜皮龙科技有限公司）· 赞助链接：https://meloong.com/afd/a/LTCat"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="直接适配内容及其分发遵循随附的上游许可证和 NOTICE；Micro-ATP 的新增内容适用根目录许可证。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="界面字体" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="本软件使用 HarmonyOS Sans SC 字体，字体版权归 Huawei Device Co., Ltd. 所有。字体许可协议随软件一同提供。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MorePlaceholderSection" Classes="pcl-card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="MorePlaceholderTitle" FontSize="17" FontWeight="SemiBold" Text="帮助" />
                                <TextBlock x:Name="MorePlaceholderDescription" Foreground="#6F7C8B" TextWrapping="Wrap" />
                                <!-- PCL2 PageOtherHelp.xaml uses a search field above its local help topics. -->
                                <TextBox x:Name="MoreHelpSearchBox" Height="34" IsVisible="False"
                                         PlaceholderText="搜索帮助" TextChanged="MoreHelpSearchTextChanged" />
                                <Separator />
                                <ItemsControl x:Name="MorePlaceholderItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="pcl-option-row">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14"
                                                               Foreground="#6F7C8B" Text="›" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Direct Avalonia adaptation of PCL/PCL-CE MyMsgLogin.xaml. -->
        <Grid Grid.RowSpan="2"
              ZIndex="100"
              Background="#730D2438"
              IsVisible="{Binding IsMicrosoftLoginRunning}">
            <Border Width="520"
                    MinHeight="248"
                    MaxHeight="420"
                    Margin="25"
                    Padding="22,20,22,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FBFCFE"
                    BorderBrush="#BFD2E4"
                    BorderThickness="1"
                    CornerRadius="7"
                    BoxShadow="0 8 24 2 #590B2338">
                <Grid RowDefinitions="Auto,2,16,*,Auto">
                    <TextBlock Grid.Row="0"
                               Margin="7,0,70,9"
                               FontSize="23"
                               Foreground="#1370F3"
                               Text="登录 Minecraft" />
                    <Border Grid.Row="1" Height="2" Background="#1370F3" />

                    <Grid Grid.Row="3" MinHeight="122" Margin="7,0,7,17">
                        <controls:PclLoadingIndicator IsVisible="{Binding !HasMicrosoftDeviceCode}"
                                                      MinHeight="122"
                                                      Text="正在准备登录…" />
                        <StackPanel IsVisible="{Binding HasMicrosoftDeviceCode}"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock FontSize="15"
                                       Foreground="#536271"
                                       Text="登录网页已经打开，设备代码也已复制。请在浏览器中完成 Microsoft 账户授权。"
                                       TextWrapping="Wrap" />
                            <Border Padding="14,9"
                                    Background="#EAF2FE"
                                    BorderBrush="#96C0F9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Foreground="#0B5BCB"
                                           Text="{Binding MicrosoftDeviceCode}" />
                            </Border>
                            <TextBlock FontSize="13"
                                       Foreground="#758392"
                                       Text="也可以在其他设备中打开 microsoft.com/devicelogin 并输入此代码。"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="13"
                                       Foreground="#3E7BB4"
                                       Text="{Binding MicrosoftLoginSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Margin="150,0,8,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Button Height="32"
                                Padding="10,0"
                                Command="{Binding OpenMicrosoftVerificationPageCommand}"
                                IsEnabled="{Binding CanOpenMicrosoftVerificationPage}"
                                Content="重新打开网页" />
                        <Button Height="32"
                                Padding="10,0"
                                Click="CopyMicrosoftCodeClick"
                                IsEnabled="{Binding HasMicrosoftDeviceCode}"
                                Content="复制代码" />
                        <Button Height="32"
                                MinWidth="64"
                                Padding="10,0"
                                Command="{Binding CancelMicrosoftLoginCommand}"
                                IsEnabled="{Binding CanCancelMicrosoftLogin}"
                                Content="取消" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>

    <Popup x:Name="CommunityFavoriteMenuPopup"
           Placement="BottomEdgeAlignedRight"
           IsLightDismissEnabled="True"
           VerticalOffset="4">
        <Border MinWidth="220" MaxWidth="280" Padding="5"
                Background="#FCFDFF" BorderBrush="#BFD3E6" BorderThickness="1"
                CornerRadius="5" BoxShadow="0 4 12 0 #30000000">
            <StackPanel x:Name="CommunityFavoriteMenuItems" Spacing="2" />
        </Border>
    </Popup>

    <Border Height="6" Margin="7,0" VerticalAlignment="Top" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeWindowPointerPressed" />
    <Border Height="6" Margin="7,0" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="6" Margin="0,7" HorizontalAlignment="Left" Background="Transparent"
            Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="6" Margin="0,7" HorizontalAlignment="Right" Background="Transparent"
            Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
            Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
            Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeWindowPointerPressed" />
    </Grid>

</Window>
