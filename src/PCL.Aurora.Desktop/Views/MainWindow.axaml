<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Aurora.Desktop.ViewModels"
        xmlns:controls="using:PCL.Aurora.Desktop.Controls"
        xmlns:converters="using:PCL.Aurora.Desktop.Converters"
        xmlns:domain="using:PCL.Aurora.Domain"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="PCL.Aurora.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Width="850"
        Height="500"
        MinWidth="810"
        MinHeight="470"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="PCL Aurora">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:MinecraftVersionIconConverter x:Key="MinecraftVersionIconConverter" />
        <converters:MinecraftLoaderIconConverter x:Key="MinecraftLoaderIconConverter" />
        <SolidColorBrush x:Key="PclThemePrimaryBrush" Color="#127AE1" />
        <LinearGradientBrush x:Key="PclTitleBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#106AC4" />
            <GradientStop Offset="0.5" Color="#1377DD" />
            <GradientStop Offset="1" Color="#106AC5" />
        </LinearGradientBrush>
        <StreamGeometry x:Key="DownloadRefreshIcon">M20 11a8.1 8.1 0 0 0-15.5-2 M4 4v5h5 M4 13a8.1 8.1 0 0 0 15.5 2 M20 20v-5h-5</StreamGeometry>
        <StreamGeometry x:Key="VersionInfoIcon">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 10v7 M12 7h.01</StreamGeometry>
        <StreamGeometry x:Key="VersionServerIcon">M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01</StreamGeometry>
        <StreamGeometry x:Key="VersionExpandDownIcon">M7 10l5 5 5-5</StreamGeometry>
        <StreamGeometry x:Key="VersionExpandUpIcon">M7 14l5-5 5 5</StreamGeometry>
        <StreamGeometry x:Key="CommunityVersionIcon">M3 6h18 M3 12h18 M3 18h18</StreamGeometry>
        <StreamGeometry x:Key="CommunityDownloadIcon">M12 3v12 M7 10l5 5 5-5 M5 21h14</StreamGeometry>
        <StreamGeometry x:Key="CommunityTimeIcon">M12 19V5 M5 12l7-7 7 7 M5 21h14</StreamGeometry>
        <StreamGeometry x:Key="CommunitySourceIcon">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 0 20 M12 2a15.3 15.3 0 0 0 0 20</StreamGeometry>
        <StreamGeometry x:Key="CommunityBackIcon">M19 12H5 M12 19l-7-7 7-7</StreamGeometry>
        <StreamGeometry x:Key="CommunityCopyIcon">M8 8h12v12H8z M4 16H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1</StreamGeometry>
        <StreamGeometry x:Key="CommunityHeartIcon">M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8z</StreamGeometry>

        <DataTemplate x:Key="CommunityProjectRowTemplate" x:DataType="vm:CommunityResourceItemViewModel">
            <Grid Classes="community-project-item" Height="64" ClipToBounds="True">
                <Button Classes="community-project-row" Tag="{Binding}" Click="CommunityResourceOpenClick"
                        AutomationProperties.Name="{Binding Project.DisplayTitle, StringFormat=查看项目 {0}}" />
                <Grid Margin="7,0,7,0" ColumnDefinitions="50,8,*" RowDefinitions="5,20,18,16,5"
                      IsHitTestVisible="False">
                    <Border Grid.Row="1" Grid.RowSpan="3" Width="50" Height="50" VerticalAlignment="Center"
                            Background="#DCEEFF" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PclThemePrimaryBrush}"
                                       IsVisible="{Binding !HasIcon}" Text="{Binding Initial}" />
                            <Image Width="50" Height="50" Stretch="UniformToFill"
                                   IsVisible="{Binding HasIcon}" Source="{Binding Icon}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="0">
                        <TextBlock FontSize="14" Foreground="#36424F" Text="{Binding Project.DisplayTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="#8B96A1" Text="{Binding Project.OriginalTitleDisplay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <ItemsControl ItemsSource="{Binding Project.CategoryTags}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="3,1" Background="#E9EDF1" CornerRadius="3">
                                        <TextBlock FontSize="11" Foreground="#7B8794" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#7B8794"
                                   Text="{Binding Project.Description}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Project.Description}" />
                    </Grid>
                    <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="4" MinWidth="0">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityVersionIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#7B8794" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#7B8794" Text="{Binding Project.CompatibilityDisplay}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityDownloadIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.CompactDownloadCountDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityTimeIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.LastUpdatedRelativeDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.SourceDisplay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Classes="community-row-action-surface" HorizontalAlignment="Right"
                        VerticalAlignment="Stretch" Padding="12,0,5,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <Button Classes="community-row-action" Tag="{Binding}" Click="CommunityResourceQuickDownloadClick"
                                ToolTip.Tip="快速下载" AutomationProperties.Name="快速下载">
                            <Path Width="15" Height="15" Data="{StaticResource CommunityDownloadIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button Classes="community-row-action" Tag="{Binding}" Click="CommunityResourceFavoriteClick"
                                ToolTip.Tip="收藏" AutomationProperties.Name="管理收藏">
                            <Grid Width="15" Height="15">
                                <Path Width="15" Height="15" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsVisible="{Binding !IsFavorite}" />
                                <Path Width="15" Height="15" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsVisible="{Binding IsFavorite}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OfficialVersionRowTemplate" x:DataType="domain:MinecraftVersionCatalogEntry">
            <Border Classes="official-version-row">
                <Grid>
                    <Button Classes="official-version-main" Tag="{Binding}" Click="OfficialVersionOpenClick"
                            AutomationProperties.Name="{Binding Id, StringFormat=下载 Minecraft {0}}">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="8">
                            <Image Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform"
                                   Source="{Binding Converter={StaticResource MinecraftVersionIconConverter}}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock FontSize="14" Text="{Binding Id}" />
                                <TextBlock FontSize="11" Foreground="#88929D"
                                           Text="{Binding ReleaseTime, StringFormat={}{0:yyyy/M/d HH:mm}}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <StackPanel Classes="version-actions" Margin="0,0,6,0" Panel.ZIndex="1"
                                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                        <Button Classes="version-row-action" Tag="{Binding}" Click="OfficialVersionChangelogClick"
                                ToolTip.Tip="更新日志" AutomationProperties.Name="{Binding Id, StringFormat=查看 Minecraft {0} 更新日志}">
                            <Path Width="18" Height="18" Data="{StaticResource VersionInfoIcon}" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button Classes="version-row-action" Tag="{Binding}" Click="OfficialVersionServerClick"
                                ToolTip.Tip="下载服务端" AutomationProperties.Name="{Binding Id, StringFormat=下载 Minecraft {0} 服务端}">
                            <Path Width="18" Height="18" Data="{StaticResource VersionServerIcon}" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Visual structure adapted for Avalonia from PCL2 FormMain.xaml and its
             PageLaunch, PageDownload, PageSetup and PageOther XAML, with PCL-CE's
             expanded download/setup navigation. Aurora retains cross-platform bindings. -->
        <Style Selector="Button.main-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="13.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.main-navigation:pointerover">
            <Setter Property="Background" Value="#32EAF2FE" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.main-navigation.selected">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PclThemePrimaryBrush}" />
        </Style>
        <Style Selector="Border.launch-side">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.pcl-card">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="#D1DDEA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.setup-card">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#D2FBFBFB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #12343D4A" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.setup-card:pointerover">
            <Setter Property="Background" Value="#EAF2FE" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #664890F5" />
        </Style>
        <Style Selector="TextBlock.setup-card-title">
            <Setter Property="Margin" Value="15,12,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.09" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.setup-card:pointerover TextBlock.setup-card-title">
            <Setter Property="Foreground" Value="#0B5BCB" />
        </Style>
        <Style Selector="TextBlock.setup-muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6F7C8B" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#343D4A" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBlock.setup-card-title">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="CaretBrush" Value="#404040" />
            <Setter Property="SelectionBrush" Value="#801370F3" />
            <Setter Property="PlaceholderForeground" Value="#A6A6A6" />
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="BorderBrush" Value="#96C0F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,0,5,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox.setup-launch-field /template/ Border#PART_BorderElement, StackPanel.setup-launch-section TextBox.setup-launch-editor /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="BorderBrush" Value="#96C0F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox:pointerover">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#4890F5" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox.setup-launch-field:pointerover /template/ Border#PART_BorderElement, StackPanel.setup-launch-section TextBox.setup-launch-editor:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#4890F5" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox:focus">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#1370F3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox.setup-launch-field:focus /template/ Border#PART_BorderElement, StackPanel.setup-launch-section TextBox.setup-launch-editor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#1370F3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox:disabled">
            <Setter Property="Background" Value="#EBEBEB" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Foreground" Value="#A6A6A6" />
            <Setter Property="PlaceholderForeground" Value="#A6A6A6" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section TextBox.setup-launch-field:disabled /template/ Border#PART_BorderElement, StackPanel.setup-launch-section TextBox.setup-launch-editor:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#EBEBEB" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="PlaceholderForeground" Value="#A6A6A6" />
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="BorderBrush" Value="#96C0F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,0,22,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="BorderBrush" Value="#96C0F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ TextBox#PART_EditableTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="7,0,0,0" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ TextBox#PART_EditableTextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="#96C0F9" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="7" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#96C0F9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BoxShadow" Value="0 2 5 0 #26000000" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:pointerover">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#4890F5" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#4890F5" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:pointerover /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="#4890F5" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:pressed, StackPanel.setup-launch-section ComboBox:focus">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#1370F3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:pressed /template/ Border#Background, StackPanel.setup-launch-section ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="#E0EAFD" />
            <Setter Property="BorderBrush" Value="#1370F3" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:disabled">
            <Setter Property="Background" Value="#EBEBEB" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Foreground" Value="#A6A6A6" />
            <Setter Property="PlaceholderForeground" Value="#A6A6A6" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:disabled /template/ Border#Background">
            <Setter Property="Background" Value="#EBEBEB" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>
        <Style Selector="StackPanel.setup-launch-section ComboBox:disabled /template/ ContentControl#ContentPresenter, StackPanel.setup-launch-section ComboBox:disabled /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="#A6A6A6" />
        </Style>
        <Style Selector="ComboBox.setup-launch-field">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.setup-launch-field">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.setup-launch-label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,25,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#36424F" />
        </Style>
        <Style Selector="RadioButton.setup-memory-mode">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#343D4A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Grid ColumnDefinitions="20,*" Background="Transparent">
                        <Ellipse x:Name="RadioBorder" Width="18" Height="18" Margin="1,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="#55FFFFFF" Stroke="#343D4A" StrokeThickness="1.1">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Fill" Duration="0:0:0.1" />
                                    <BrushTransition Property="Stroke" Duration="0:0:0.1" />
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                        <Ellipse x:Name="RadioDot" Width="8" Height="8" Margin="6,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="#0B5BCB" Opacity="0">
                            <Ellipse.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                </Transitions>
                            </Ellipse.Transitions>
                        </Ellipse>
                        <ContentPresenter Grid.Column="1" Margin="6,0,0,0"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Left"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.setup-memory-mode:checked /template/ Ellipse#RadioBorder">
            <Setter Property="Stroke" Value="#0B5BCB" />
        </Style>
        <Style Selector="RadioButton.setup-memory-mode:checked /template/ Ellipse#RadioDot">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="RadioButton.setup-memory-mode:pointerover">
