        <Style Selector="StackPanel.setup-launch-section Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="#96C0F9" />
            <Setter Property="Background" Value="#4D96C0F9" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16" VerticalAlignment="Center">
                        <Border x:Name="SliderTrackBackground" Height="1" Margin="1,0"
                                VerticalAlignment="Center" Background="#8096C0F9" />
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               Orientation="Horizontal">
                            <Track.DecreaseButton>
                                <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Width="10" Height="10">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="SliderThumbVisual" Width="10" Height="10"
                                                    Background="#96C0F9" BorderBrush="#96C0F9"
                                                    BorderThickness="1.2" CornerRadius="5">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                                                    </Transitions>
                                                </Border.Transitions>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.setup-launch-section Slider:pointerover">
            <Setter Property="Foreground" Value="#1370F3" />
            <Setter Property="Background" Value="#4D1370F3" />
        </Style>
