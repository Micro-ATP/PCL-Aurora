        <Style Selector="Grid.download-navigation-row Button.download-refresh:focus-visible">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PclThemePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.download-loading-card">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="114" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="#D1DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #24000000" />
        </Style>
        <Style Selector="TextBox.community-search-input">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox.community-search-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox.community-search-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox.community-search-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.community-filter">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style Selector="ListBox.download-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderBrush" Value="#E0E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
            <Setter Property="Foreground" Value="#24415F" />
            <Setter Property="BorderBrush" Value="#C7DEF5" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:selected">
            <Setter Property="Background" Value="#DCEEFF" />
            <Setter Property="Foreground" Value="#0F5FCC" />
            <Setter Property="BorderBrush" Value="#83B8F8" />
        </Style>
        <Style Selector="ListBox.download-list ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#D3E9FF" />
            <Setter Property="Foreground" Value="#0F5FCC" />
        </Style>
        <Style Selector="Border.official-version-row">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.official-version-row:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
        </Style>
        <Style Selector="Button.official-version-main">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0,74,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.official-version-main:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.official-version-main:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
        <Style Selector="Border.official-version-row:focus-within">
            <Setter Property="Background" Value="#E4F1FF" />
        </Style>
        <Style Selector="StackPanel.version-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.official-version-row:pointerover StackPanel.version-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.official-version-row:focus-within StackPanel.version-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.version-row-action">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2C85E8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.version-row-action:pointerover">
            <Setter Property="Background" Value="#D3E9FF" />
            <Setter Property="Foreground" Value="#1265C1" />
        </Style>
        <Style Selector="Border.version-category-card">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #16000000" />
        </Style>
        <Style Selector="Border.version-category-card:pointerover">
            <Setter Property="BoxShadow" Value="0 2 5 0 #240B5BCB" />
        </Style>
        <Style Selector="ToggleButton.version-category-header">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0,16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.version-category-header:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PclThemePrimaryBrush}" />
            <Setter Property="Background" Value="#F8FBFE" />
        </Style>
        <Style Selector="ToggleButton.version-category-header:pressed">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.loader-directory-header">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0,16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.loader-directory-header:pointerover">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="Foreground" Value="{StaticResource PclThemePrimaryBrush}" />
        </Style>
        <Style Selector="Button.loader-directory-header:pressed">
            <Setter Property="Background" Value="#EAF4FF" />
        </Style>
        <Style Selector="Button.loader-package-main">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="8,0,44,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.loader-package-main:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.loader-package-main:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
        <Style Selector="Button.version-component">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="Foreground" Value="#344150" />
            <Setter Property="BorderBrush" Value="#D1DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.version-component:pointerover">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="BorderBrush" Value="#9FC8EC" />
        </Style>
        <Style Selector="Button.version-detail-back">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7D8894" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.version-detail-back:pointerover">
            <Setter Property="Background" Value="#EDF6FF" />
            <Setter Property="Foreground" Value="#176FC5" />
        </Style>
        <Style Selector="Button.install-component-clear">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,5,32,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6F7C8B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.install-component-clear:pointerover">
            <Setter Property="Background" Value="#E4F1FF" />
            <Setter Property="Foreground" Value="{StaticResource PclThemePrimaryBrush}" />
        </Style>
        <Style Selector="Button.install-version-row">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#344150" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.install-version-row:pointerover">
            <Setter Property="Background" Value="#EAF4FF" />
            <Setter Property="Foreground" Value="{StaticResource PclThemePrimaryBrush}" />
        </Style>
        <Style Selector="Button.install-version-row:pressed">
            <Setter Property="Background" Value="#D3E9FF" />
        </Style>
    </Window.Styles>

    <Grid>
    <Border CornerRadius="8" ClipToBounds="True">
    <Grid Classes="pcl-shell" RowDefinitions="48,*">
        <Border x:Name="MainTitleBar" Background="{StaticResource PclTitleBarBrush}" PointerPressed="TitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontSize="17" FontWeight="Normal" Foreground="White" Text="PCL Aurora" />
                </StackPanel>
                <StackPanel Grid.Column="1" Height="27" Margin="13,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Original PCL2 title-navigation paths adapted from FormMain.xaml. -->
                    <Button x:Name="LaunchNavigation" Classes="main-navigation selected" Tag="0" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="12,0,0,0">
                                <Path Width="14.4" Height="14.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M52.1,164.5c-1.4,0-3.1-0.5-4.2-1.3c-2.6-1.7-4-4.2-4-7V43.8c0-2.9,1.6-5.8,4.1-7c1.2-0.8,2.7-1.2,4.1-1.2c1.5,0,2.9,0.4,4.2,1.2L153.1,93c0,0,0.1,0,0.1,0.1c2.6,1.7,4,4.2,4,7c0,3-1.7,5.8-4.2,7.1l-96.8,56.2C55.1,164,53.5,164.5,52.1,164.5z M60.4,142.1l72.1-42.1L60.4,58.2V142.1z" />
                            </Grid>
                            <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="启动" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadNavigation" Classes="main-navigation" Tag="1" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="12,0,0,0">
                                <Path Width="14.4" Height="14.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z" />
                            </Grid>
                            <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="下载" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavigation" Classes="main-navigation" Tag="2" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="12,0,0,0">
                                <Path Width="17.6" Height="17.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z" />
                            </Grid>
                            <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreNavigation" Classes="main-navigation" Tag="3" Click="MainNavigationClick">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="12,0,0,0">
                                <Path Width="14.88" Height="14.88" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M364 0h-273C40 0 0 40 0 91v273C0 414 40 455 91 455h273C414 455 455 414 455 364V91C455 40 414 0 364 0zM341 341H113V113h227v227zM933 0h-273C609 0 568 40 568 91v273c0 50 40 91 91 91h273C983 455 1024 414 1024 364V91c0-50-40-91-90-91zM910 341h-227V113h227v227zM364 568h-273C40 568 0 609 0 659v273c0 50 40 91 91 91h273C414 1024 455 983 455 932v-273C455 609 414 568 364 568zM341 910H113v-227h227v227zM933 568h-273c-50 0-91 40-91 91v273c0 50 40 91 91 91h273c50 0 90-40 90-91v-273c0-50-40-90-90-90zM910 910h-227v-227h227v227z" />
                            </Grid>
                            <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="更多" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="4"
                            HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Paths and 28 px sizing follow PCL2 FormMain.xaml title controls. -->
                    <Button Classes="window-control" Click="MinimizeWindowClick" ToolTip.Tip="最小化">
                        <Path Width="15" Height="2" Stretch="Fill" Fill="White"
                              Data="M0,0 h15 v2 h-15 v-2 Z" />
                    </Button>
                    <Button Classes="window-control" Click="CloseWindowClick" ToolTip.Tip="关闭">
                        <Path Width="14.4" Height="14.4" Stretch="Uniform" Fill="White"
                              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="CommunityDetailTitleBar" Background="{StaticResource PclTitleBarBrush}"
                PointerPressed="TitleBarPointerPressed" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="community-detail-title-back" Click="CommunityResourceBackClick"
                        ToolTip.Tip="返回资源目录" AutomationProperties.Name="返回资源目录">
                    <Path Width="18" Height="18" Data="{StaticResource CommunityBackIcon}" Stretch="Uniform"
                          Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                </Button>
                <TextBlock x:Name="CommunityDetailTitleBarTitle" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                           Text="资源下载" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="4"
                            HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="window-control" Click="MinimizeWindowClick" ToolTip.Tip="最小化">
                        <Path Width="15" Height="2" Stretch="Fill" Fill="White"
                              Data="M0,0 h15 v2 h-15 v-2 Z" />
                    </Button>
                    <Button Classes="window-control" Click="CloseWindowClick" ToolTip.Tip="关闭">
                        <Path Width="14.4" Height="14.4" Stretch="Uniform" Fill="White"
                              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainPages" Grid.Row="1" ClipToBounds="True">
            <Grid x:Name="LaunchPage">
                <Grid ColumnDefinitions="300,*" Background="#D9EAF9">
                    <Border Classes="pcl-page-left" Background="#FCFCFD" BorderBrush="#D7DCE2" BorderThickness="0,0,1,0">
                        <Grid Margin="20,20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <!-- Icons reused from PCL2 PageLaunchLeft.xaml under the upstream project license. -->
                                <Button Classes="account-mode" Classes.selected="{Binding IsMicrosoftAccountMode}"
                                        Command="{Binding ShowMicrosoftAccountCommand}"
                                        ToolTip.Tip="{Binding MicrosoftLoginSummary}">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Width="18" Height="18" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" />
                                        <TextBlock Text="正版" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="account-mode" Classes.selected="{Binding IsOfflineAccountMode}"
                                        Command="{Binding ShowOfflineAccountCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Width="17" Height="17" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" />
                                        <TextBlock Text="离线" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="6">
                                <Border Classes="pcl-status-strip" Background="#E8F3FF">
                                    <TextBlock FontSize="12" Foreground="#2472C8" Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                                </Border>
                                <Border Classes="pcl-status-strip" Background="#FFF4D7" IsVisible="{Binding NeedsGameDownload}">
                                    <TextBlock FontSize="12" Foreground="#9A6A00" Text="尚未发现可用实例，请先下载或选择游戏版本" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                <StackPanel IsVisible="{Binding IsOfflineAccountMode}" Spacing="12">
                                    <Border Width="56" Height="56" CornerRadius="3" HorizontalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <Image Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="Fill" RenderOptions.BitmapInterpolationMode="None">
                                                <Image.Source>
                                                    <CroppedBitmap Source="/Assets/Skins/PclCeAlex.png" SourceRect="8,8,8,8" />
                                                </Image.Source>
                                            </Image>
                                            <Image Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="Fill" RenderOptions.BitmapInterpolationMode="None">
                                                <Image.Source>
                                                    <CroppedBitmap Source="/Assets/Skins/PclCeAlex.png" SourceRect="40,8,8,8" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Height="35" PlaceholderText="游戏用户名" Text="{Binding OfflinePlayerName}" />
                                        <Button Grid.Column="1" Height="35" MinWidth="76"
                                                Command="{Binding UseOfflineAccountCommand}" Content="使用" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsMicrosoftAccountMode}" Spacing="11">
                                    <Path Width="40" Height="40" HorizontalAlignment="Center" Stretch="Uniform"
                                          Fill="Transparent" Stroke="#6B7C8F" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding MicrosoftAccountDisplayName}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="#6F7C8B"
                                                   Text="{Binding MicrosoftLoginSummary}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Height="34" MinWidth="96" Margin="4,0"
                                                    Command="{Binding StartMicrosoftLoginCommand}"
                                                    IsEnabled="{Binding CanStartMicrosoftLogin}" Content="登录" />
                                            <Button Height="32" MinWidth="76" Margin="4,0"
                                                    IsVisible="{Binding HasMicrosoftAccountProfile}"
                                                    Command="{Binding RestoreMicrosoftLoginCommand}"
                                                    IsEnabled="{Binding CanRestoreMicrosoftLogin}" Content="恢复登录" />
                                            <Button Height="32" MinWidth="76" Margin="4,0"
                                                    IsVisible="{Binding HasMicrosoftAccountProfile}"
                                                    Command="{Binding ClearMicrosoftLoginCommand}" Content="退出登录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Spacing="8">
                                <Button Classes="launch-action launch-download-button" Click="OpenDownloadPageClick"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding NeedsGameDownload}" Height="54" FontSize="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock HorizontalAlignment="Center" Text="下载游戏" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Opacity="0.65" Text="未找到可用的游戏版本" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="launch-action launch-button" Command="{Binding LaunchGameCommand}"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding HasAvailableInstances}"
                                        IsEnabled="{Binding CanLaunchGame}" Height="52" FontSize="16" Content="启动游戏" />
                                <Button Classes="launch-action launch-download-button" Click="OpenDownloadPageClick"
                                        HorizontalAlignment="Stretch"
                                        Height="35" FontSize="14" Content="版本选择" />
                            </StackPanel>
                            <ComboBox Grid.Row="4" x:Name="InstanceSelector"
                                      AutomationProperties.Name="启动实例"
                                      IsVisible="{Binding HasAvailableInstances}"
                                      ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="#6F7C8B"
                                                       Text="{Binding VersionDisplay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Classes="pcl-page-right" Background="#D9EAF9">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,24,28,28" MaxWidth="520"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="14">
                                <!-- Direct Avalonia adaptation of PCL-CE PageLaunchRight's community notice card. -->
                                <Border Classes="pcl-notice" Padding="0">
                                    <Grid RowDefinitions="40,*">
                                        <TextBlock Margin="18,0" VerticalAlignment="Center"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PclThemePrimaryBrush}" Text="PCL Aurora 提示" />
                                        <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="#E2E8F0" />
                                        <StackPanel Grid.Row="1" Margin="18,14,18,17" Spacing="11">
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="你正在使用 PCL Aurora（PCL 跨平台版）！此版本为独立开发和维护，与原版维护路线不同，体验有所出入。" />
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="如果你是意外下载到了 PCL Aurora，我们十分建议您下载原版 PCL 长期使用，此发行版本对新手用户体验可能不友好。" />
                                            <TextBlock FontSize="13.5" Foreground="#4F5E6E" LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Text="此外，PCL Aurora 的问题请向 PCL Aurora 的仓库提交 Issue，不要向官方仓库反馈 PCL Aurora 的问题哦！" />

                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="pcl-notice" IsVisible="{Binding HasAvailableInstances}">
                                    <StackPanel Spacing="9">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PclThemePrimaryBrush}" Text="启动状态" />
                                        <TextBlock Text="{Binding GameLaunchSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding LaunchPreflightSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding VersionMetadataSummary}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#6F7C8B" Text="{Binding JavaRequirementSummary}" TextWrapping="Wrap" />
                                        <CheckBox IsEnabled="{Binding RequiresAccountGuidance}"
                                                  IsChecked="{Binding HasAcknowledgedAccountGuidance}"
                                                  Content="我已知悉正版购买与上游赞助提示。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="DownloadPage" IsVisible="False">
                <Grid x:Name="DownloadPageLayout" Background="#D9EAF9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="178" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DownloadSidebar" Classes="pcl-page-left" Background="#FCFCFD" Padding="0,12,0,0"
                            BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Column names follow PCL2 PageDownloadLeft.xaml with PCL-CE installer additions. -->
                            <StackPanel x:Name="DownloadNavigationPanel" Spacing="2">
                                <Grid Classes="download-navigation-row selected" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation selected" Click="DownloadNavigationClick"
                                                                  Tag="game" Label="原版游戏"
                                                                  IconData="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7 12 12l8.7-5 M12 22V12" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="game" Click="DownloadSectionRefreshClick"
                                            ToolTip.Tip="刷新" AutomationProperties.Name="刷新原版游戏">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="社区资源" />
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="mod" Label="模组"
                                                                  IconData="M14.7 6.3 17.7 3.3 20.7 6.3 17.7 9.3 M14.7 6.3 4 17v3h3l10.7-10.7" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="mod" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新模组">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="pack" Label="整合包" IconData="M21 8v13H3V8 M1 3h22v5H1z M10 12h4" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="pack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新整合包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="datapack" Label="数据包" IconData="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M9 13h6 M9 17h6" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="datapack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新数据包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="resourcepack" Label="资源包" IconData="M12 2 2 7l10 5 10-5-10-5z M2 12l10 5 10-5 M2 17l10 5 10-5" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="resourcepack" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新资源包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="shader" Label="光影包" IconData="M12 2v2 M12 20v2 M4.93 4.93l1.42 1.42 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M4.93 19.07l1.42-1.41 M17.66 6.34l1.41-1.41 M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="shader" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新光影包">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="world" Label="世界" IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 0 20 M12 2a15.3 15.3 0 0 0 0 20" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="world" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新世界">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="favorites" Label="收藏夹" IconData="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="favorites" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新收藏夹">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="安装包" />
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="optifine" Label="OptiFine" IconData="M12 14l4-4 M3.34 19a10 10 0 1 1 17.32 0" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="optifine" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 OptiFine">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="forge" Label="Forge" IconData="M7 10H6a4 4 0 0 1-4-4 1 1 0 0 1 1-1h4 M7 5a1 1 0 0 1 1-1h13a1 1 0 0 1 1 1 7 7 0 0 1-7 7H8a1 1 0 0 1-1-1z M9 12v5 M15 12v5 M5 20a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3 1 1 0 0 1-1 1H6a1 1 0 0 1-1-1" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="forge" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Forge">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="neoforge" Label="NeoForge" IconData="M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7 .57 1.07 1 2.24 1 3.44C21 17.9 16.97 21 12 21s-9-3-9-7.56c0-1.25.5-2.4 1-3.44 0 0-1.89-6.42-.5-7 1.39-.58 4.72.23 6.5 2.23A9.04 9.04 0 0 1 12 5Z M8 14v.5 M16 14v.5 M11.25 16.25h1.5L12 17l-.75-.75Z" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="neoforge" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 NeoForge">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="fabric" Label="Fabric" IconData="M19 17V5a2 2 0 0 0-2-2H4 M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="fabric" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Fabric">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="cleanroom" Label="Cleanroom" IconData="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2 M6.453 15h11.094 M8.5 2h7" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="cleanroom" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Cleanroom">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="legacy-fabric" Label="Legacy Fabric" IconData="M19 17V5a2 2 0 0 0-2-2H4 M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="legacy-fabric" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 Legacy Fabric">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="labymod" Label="LabyMod" IconData="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z M3.3 7l8.7 5 8.7-5 M12 22V12" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="labymod" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 LabyMod">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                                <Grid Classes="download-navigation-row" ColumnDefinitions="*,36">
                                    <controls:PclNavigationButton Classes="secondary-navigation" Click="DownloadNavigationClick" Tag="liteloader" Label="LiteLoader" IconData="M12 2C8 2 4 8 4 14a8 8 0 0 0 16 0c0-6-4-12-8-12" />
                                    <Button Grid.Column="1" Classes="download-refresh" Tag="liteloader" Click="DownloadSectionRefreshClick" ToolTip.Tip="刷新" AutomationProperties.Name="刷新 LiteLoader">
                                        <Path Width="18" Height="18" Data="{StaticResource DownloadRefreshIcon}" Stretch="Uniform" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="DownloadContentScroller" Grid.Column="1" Classes="pcl-page-right"
                                  Background="#D9EAF9" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="25,10,25,25" MaxWidth="860" Spacing="15">
                            <!-- PCL2 PageDownloadClient/PageDownloadInstall structure adapted to Aurora's existing commands. -->
                            <StackPanel x:Name="DownloadGameView" MinHeight="430" Spacing="15">
                                <StackPanel IsVisible="{Binding !IsVersionCatalogLoading}" Spacing="15">
                                    <Border Classes="version-category-card" Padding="12,8,12,12">
                                        <StackPanel>
                                            <TextBlock Margin="3,0,0,5" FontSize="13" FontWeight="Bold" Text="最新版本" />
                                            <ContentControl Content="{Binding LatestReleaseVersion}"
                                                            ContentTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                            <ContentControl Content="{Binding LatestSnapshotVersion}"
                                                            ContentTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="ReleaseVersionToggle" Classes="version-category-header" Tag="release"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding ReleaseVersions.Count, StringFormat=正式版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=ReleaseVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=ReleaseVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="ReleaseVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=ReleaseVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="SnapshotVersionToggle" Classes="version-category-header" Tag="snapshot"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding SnapshotVersions.Count, StringFormat=预览版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=SnapshotVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=SnapshotVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="SnapshotVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=SnapshotVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="LegacyVersionToggle" Classes="version-category-header" Tag="legacy"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding LegacyVersions.Count, StringFormat=远古版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=LegacyVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=LegacyVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="LegacyVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=LegacyVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="version-category-card">
                                        <StackPanel>
                                            <ToggleButton x:Name="AprilFoolsVersionToggle" Classes="version-category-header" Tag="april-fools"
                                                          Click="VersionCategoryToggleClick">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                               Text="{Binding AprilFoolsVersions.Count, StringFormat=愚人节版 ({0})}" />
                                                    <Grid Grid.Column="1" Width="18" Height="18">
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding !IsChecked, ElementName=AprilFoolsVersionToggle}" />
                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform" Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              IsVisible="{Binding IsChecked, ElementName=AprilFoolsVersionToggle}" />
                                                    </Grid>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl x:Name="AprilFoolsVersionItems" Margin="12,0,12,12"
                                                          IsVisible="{Binding IsChecked, ElementName=AprilFoolsVersionToggle}"
                                                          ItemTemplate="{StaticResource OfficialVersionRowTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Classes="download-loading-card" Margin="0,38,0,38"
                                        IsVisible="{Binding IsVersionCatalogLoading}">
                                    <controls:PclLoadingIndicator Text="正在获取版本列表" />
                                </Border>
                            </StackPanel>

                            <!-- Direct Avalonia adaptation of PCL-CE PageDownloadInstall's component selection page. -->
                            <StackPanel x:Name="DownloadCombinedInstallView" IsVisible="False" MinHeight="430" Spacing="12">
                                <Border Classes="version-category-card" Height="62" Margin="0,15,0,3">
                                    <Grid ColumnDefinitions="42,40,*" Margin="10,0,16,0">
                                        <Button Classes="version-detail-back" Click="CombinedInstallBackClick"
                                                ToolTip.Tip="返回版本列表" AutomationProperties.Name="返回版本列表">
                                            <Path Width="18" Height="18" Data="M19 12H5 M12 19l-7-7 7-7"
                                                  Stretch="Uniform" Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Button>
                                        <Image Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center"
                                               Source="{Binding SelectedCatalogVersion, Converter={StaticResource MinecraftVersionIconConverter}}" />
                                        <StackPanel Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding CombinedInstallationName}" />
                                            <TextBlock FontSize="11" Foreground="#7D8894"
                                                       Text="{Binding SelectedCatalogVersion.Id, StringFormat=Minecraft {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,32,0,32"
                                        IsVisible="{Binding IsCombinedInstallerLoading}">
                                    <controls:PclLoadingIndicator Text="正在获取可选组件" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding CombinedInstallComponents}"
                                              IsVisible="{Binding !IsCombinedInstallerLoading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MinecraftInstallComponentViewModel">
                                            <Border Classes="version-category-card" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <ToggleButton Classes="version-category-header"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanExpand}">
                                                            <Grid ColumnDefinitions="110,22,*,20" ColumnSpacing="7">
                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                           Text="{Binding DisplayName}" />
                                                                <Image Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center"
                                                                       Stretch="Uniform" Source="{Binding IconPath}"
                                                                       IsVisible="{Binding HasSelection}" />
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#6F7C8B"
                                                                           TextTrimming="CharacterEllipsis" Text="{Binding HeaderSummary}" />
                                                                <Grid Grid.Column="3" Width="18" Height="18" IsVisible="{Binding CanExpand}">
                                                                    <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}"
                                                                          Stretch="Uniform" Fill="Transparent" Stroke="#6F7C8B"
                                                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          IsVisible="{Binding !IsExpanded}" />
                                                                    <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}"
                                                                          Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PclThemePrimaryBrush}"
                                                                          StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          IsVisible="{Binding IsExpanded}" />
                                                                </Grid>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <Button Classes="install-component-clear" Tag="{Binding Kind}"
                                                                Click="CombinedInstallComponentClearClick"
                                                                IsVisible="{Binding HasSelection}"
                                                                ToolTip.Tip="清除所选版本"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=清除所选 {0}}">
                                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                                                        </Button>
                                                    </Grid>
                                                    <ItemsControl Margin="20,0,18,15" ItemsSource="{Binding Versions}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="domain:MinecraftLoaderCatalogEntry">
                                                                <Button Classes="install-version-row" Tag="{Binding}"
                                                                        Click="CombinedInstallComponentVersionClick"
                                                                        AutomationProperties.Name="{Binding Version, StringFormat=选择版本 {0}}">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Version}" />
                                                                            <TextBlock FontSize="11" Foreground="#89939E"
                                                                                       Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                                                   Foreground="#6F7C8B" Text="{Binding Channel}" />
                                                                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="6,2"
                                                                                CornerRadius="2" Background="#E8F7EE"
                                                                                IsVisible="{Binding IsRecommended}">
                                                                            <TextBlock FontSize="11" Foreground="#287A49" Text="推荐" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Classes="version-category-card" Padding="16,13" Margin="0,3,0,15"
                                        IsVisible="{Binding !IsCombinedInstallerLoading}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock VerticalAlignment="Center" Foreground="#5F6C79" TextWrapping="Wrap"
                                                   Text="{Binding CombinedInstallationSummary}" />
                                        <Button Grid.Column="1" Classes="download-primary" MinWidth="112"
                                                Click="CombinedInstallStartClick"
                                                IsEnabled="{Binding CanStartCombinedInstallation}"
                                                Content="开始安装" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Direct Avalonia adaptation of PCL-CE's independent installer directories. -->
                            <StackPanel x:Name="DownloadLoaderView" IsVisible="False" MinHeight="430" Spacing="15">
                                <Border Classes="pcl-card" Padding="18">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="DownloadLoaderIntroTitle" FontSize="16" FontWeight="SemiBold" Text="Forge 简介" />
                                        <TextBlock x:Name="DownloadLoaderIntroDescription" Foreground="#5F6C79" TextWrapping="Wrap"
                                                   Text="Forge 是一个模组加载器，你需要先安装 Forge 才能安装各种 Forge 模组。" />
                                        <Button x:Name="DownloadLoaderWebsiteButton" Classes="download-primary"
                                                MinWidth="140" Height="35" HorizontalAlignment="Left"
                                                Click="LoaderWebsiteClick" Content="打开官方网站" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,38,0,38"
                                        IsVisible="{Binding IsLoaderPageLoading}">
                                    <controls:PclLoadingIndicator x:Name="LoaderCatalogLoadingIndicator"
                                                                  Text="正在获取 Forge 列表…" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding LoaderDirectoryGroups}"
                                              IsVisible="{Binding !IsLoaderPageLoading}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MinecraftLoaderDirectoryGroupViewModel">
                                            <Border Classes="version-category-card" Margin="0,0,0,15">
                                                <StackPanel>
                                                    <Button Classes="loader-directory-header" Tag="{Binding}"
                                                            Click="LoaderDirectoryGroupClick"
                                                            IsVisible="{Binding IsCollapsible}"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=展开 {0}}">
                                                        <Grid ColumnDefinitions="*,20">
                                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                       Text="{Binding Title}" />
                                                            <Grid Grid.Column="1" Width="18" Height="18">
                                                                <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}"
                                                                      Stretch="Uniform" Fill="Transparent" Stroke="#6F7C8B"
                                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      IsVisible="{Binding !IsExpanded}" />
                                                                <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}"
                                                                      Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PclThemePrimaryBrush}"
                                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                      IsVisible="{Binding IsExpanded}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Button>
                                                    <Grid Height="40" Margin="15,0,16,0" IsVisible="{Binding !IsCollapsible}">
                                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                   Text="{Binding Title}" />
                                                    </Grid>
                                                    <Border Classes="download-loading-card" Margin="18,4,18,14"
                                                            IsVisible="{Binding IsLoading}">
                                                        <controls:PclLoadingIndicator Text="{Binding StatusText}" />
                                                    </Border>
                                                    <TextBlock Margin="20,4,18,14" Foreground="#A44343" TextWrapping="Wrap"
                                                               IsVisible="{Binding HasError}"
                                                               Text="{Binding Error}" />
                                                    <ItemsControl Margin="12,0,12,12" ItemsSource="{Binding Entries}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MinecraftLoaderPackageItemViewModel">
                                                                <Border Classes="official-version-row">
                                                                    <Grid>
                                                                        <Button Classes="loader-package-main" Tag="{Binding}"
                                                                                Click="LoaderPackageDownloadClick"
                                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=下载 {0}}">
                                                                            <Grid ColumnDefinitions="34,*" ColumnSpacing="8">
                                                                                <Image Width="30" Height="30" VerticalAlignment="Center"
                                                                                       Stretch="Uniform"
                                                                                       Source="{Binding Kind, Converter={StaticResource MinecraftLoaderIconConverter}}" />
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <TextBlock FontSize="14" Text="{Binding DisplayName}" />
                                                                                        <TextBlock FontSize="11" Foreground="#287A49"
                                                                                                   VerticalAlignment="Center" IsVisible="{Binding IsRecommended}"
                                                                                                   Text="推荐" />
                                                                                    </StackPanel>
                                                                                    <TextBlock FontSize="11" Foreground="#88929D"
                                                                                               Text="{Binding Information}" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Button>
                                                                        <StackPanel Classes="version-actions" Margin="0,0,6,0"
                                                                                    Orientation="Horizontal" HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Center" Spacing="1">
                                                                            <Button Classes="version-row-action" Tag="{Binding}"
                                                                                    Click="LoaderPackageChangelogClick"
                                                                                    IsVisible="{Binding HasChangelog}"
                                                                                    ToolTip.Tip="更新日志" AutomationProperties.Name="查看更新日志">
                                                                                <Path Width="18" Height="18" Data="{StaticResource VersionInfoIcon}"
                                                                                      Stretch="Uniform" Fill="Transparent"
                                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="5,0" Foreground="#A44343" TextWrapping="Wrap"
                                           IsVisible="{Binding HasLoaderDirectorySummary}"
                                           Text="{Binding LoaderDirectorySummary}" />

                            </StackPanel>

                            <!-- Search structure directly adapts PCL2 PageResource and PCL-CE PageComp.
                                 Aurora uses Avalonia bindings and credential-free public catalogs. -->
                            <StackPanel x:Name="DownloadCommunityCard" MinHeight="430" Spacing="12" IsVisible="False">
                                <StackPanel x:Name="DownloadCommunityCatalogView" Spacing="12">
                                <StackPanel IsVisible="{Binding IsCommunityFavoritesPage}" Spacing="15">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                        <Border Classes="pcl-card" Padding="10,7"
                                                IsVisible="{Binding IsCommunityFavoriteSearchVisible}">
                                            <Grid Height="34" ColumnDefinitions="24,*" ColumnSpacing="8">
                                                <Path Width="18" Height="18" VerticalAlignment="Center"
                                                      Data="M21 21l-4.35-4.35 M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16"
                                                      Fill="Transparent" Stroke="#36424F" StrokeThickness="2"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                                <TextBox Grid.Column="1" Classes="community-search-input"
                                                         PlaceholderText="在当前收藏夹中搜索"
                                                         Text="{Binding CommunityFavoriteSearchText}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Classes="pcl-card" Height="48" Padding="8,5">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ComboBox MinWidth="96" MaxWidth="180" VerticalAlignment="Center"
                                                          ItemsSource="{Binding CommunityFavoriteFolders}"
                                                          SelectedItem="{Binding SelectedCommunityFavoriteFolder}"
                                                          SelectionChanged="CommunityFavoriteFolderSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="domain:CommunityFavoriteFolder">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Classes="community-row-action" Width="34" Height="34"
                                                        Click="CommunityFavoriteManageClick" ToolTip.Tip="管理收藏夹"
                                                        AutomationProperties.Name="管理收藏夹">
                                                    <Path Width="17" Height="17"
                                                          Data="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.14.37.2.75.2 1.1s.2.73.6 1c.3.2.68.4 1.1.4H21a2 2 0 1 1 0 4h-.09c-.42 0-.8.2-1.1.5-.2.3-.4.68-.4 1z"
                                                          Stretch="Uniform" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding CommunityFavoriteGroups}"
                                                  IsVisible="{Binding IsCommunityFavoriteListVisible}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommunityFavoriteGroupViewModel">
                                                <Border Classes="version-category-card" Margin="0,0,0,15" Padding="12,8,12,12">
                                                    <StackPanel>
                                                        <TextBlock Margin="3,0,0,5" FontSize="13" FontWeight="Bold"
                                                                   Text="{Binding Title, StringFormat={}{0}}" />
                                                        <ItemsControl ItemsSource="{Binding Items}"
                                                                      ItemTemplate="{StaticResource CommunityProjectRowTemplate}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Classes="pcl-card" Width="560" MaxWidth="720" Padding="24,18"
                                            Margin="40,80" HorizontalAlignment="Center"
                                            IsVisible="{Binding IsCommunityFavoriteEmptyVisible}">
                                        <StackPanel>
                                            <TextBlock HorizontalAlignment="Center" FontSize="19" Foreground="#2780DF"
                                                       Text="{Binding CommunityFavoriteEmptyTitle}" />
                                            <Border Height="2" Margin="0,10,0,15" Background="#2780DF" />
                                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                                                       Text="{Binding CommunityFavoriteEmptyDescription}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Classes="pcl-card" Padding="10,7"
                                        IsVisible="{Binding IsCommunityCatalogAvailable}">
                                    <Grid Height="34" ColumnDefinitions="24,*,88" ColumnSpacing="8">
                                        <Path Width="18" Height="18" VerticalAlignment="Center"
                                              Data="M21 21l-4.35-4.35 M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16"
                                              Fill="Transparent" Stroke="#36424F" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBox Grid.Column="1" Classes="community-search-input"
                                                 PlaceholderText="搜索资源"
                                                 Text="{Binding CommunitySearchText}" />
                                        <Button Grid.Column="2" Classes="community-action-primary"
                                                Height="34" MinWidth="88"
                                                Command="{Binding SearchCommunityResourcesCommand}"
                                                Content="搜索" />
                                    </Grid>
                                </Border>

                                <Border Classes="pcl-card" Padding="14"
                                        IsVisible="{Binding IsCommunityCatalogAvailable}">
                                    <Grid ColumnDefinitions="Auto,1*,Auto,1.3*,Auto,1*,Auto"
                                          RowDefinitions="30,10,30" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" Text="来源" />
                                        <ComboBox Grid.Column="1" Classes="community-filter" SelectedIndex="0">
                                            <ComboBoxItem Content="全部" />
                                        </ComboBox>

                                        <TextBlock Grid.Column="2" Margin="0,0,2,0" VerticalAlignment="Center" Text="标签" />
                                        <ComboBox Grid.Column="3" Classes="community-filter"
                                                  ItemsSource="{Binding CommunityResourceCategoryOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceCategory}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceCategoryOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="4" Margin="0,0,2,0" VerticalAlignment="Center" Text="排序方式" />
                                        <ComboBox Grid.Column="5" Classes="community-filter"
                                                  ItemsSource="{Binding CommunityResourceSortOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceSort}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceSortOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,2,0" VerticalAlignment="Center" Text="版本" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Height="30"
                                                 PlaceholderText="全部（也可自行输入）"
                                                 Text="{Binding CommunityGameVersion}" />

                                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,2,0" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCommunityLoaderFilterVisible}" Text="加载器" />
                                        <ComboBox Grid.Row="2" Grid.Column="3" Classes="community-filter"
                                                  IsVisible="{Binding IsCommunityLoaderFilterVisible}"
                                                  ItemsSource="{Binding CommunityResourceLoaderOptions}"
                                                  SelectedItem="{Binding SelectedCommunityResourceLoader}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CommunityResourceLoaderOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Classes="pcl-status-strip" Background="#EDF6FF"
                                        IsVisible="{Binding IsCommunityStatusVisible}">
                                    <TextBlock FontSize="12" Foreground="#365879"
                                               Text="{Binding CommunityResourceSummary}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Classes="download-loading-card" Margin="0,41,0,41"
                                        IsVisible="{Binding IsCommunitySearchRunning}">
                                    <controls:PclLoadingIndicator Text="{Binding CommunityLoadingText}" />
                                </Border>

                                <Border Classes="pcl-card" Padding="12" IsVisible="{Binding IsCommunityResultListVisible}">
                                    <ItemsControl ItemsSource="{Binding CommunityResources}"
                                                  ItemTemplate="{StaticResource CommunityProjectRowTemplate}" />
                                </Border>

                                <Border Classes="pcl-card" Padding="12"
                                        IsVisible="{Binding IsCommunityFooterVisible}">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <Button MinWidth="72" Command="{Binding PreviousCommunityPageCommand}"
                                                    IsEnabled="{Binding CanGoToPreviousCommunityPage}" Content="上一页" />
                                            <Border MinWidth="42" Background="#EDF6FF" CornerRadius="3" Padding="10,7">
                                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                                           Text="{Binding CommunityPageNumber}" />
                                            </Border>
                                            <Button MinWidth="72" Command="{Binding NextCommunityPageCommand}"
                                                    IsEnabled="{Binding CanGoToNextCommunityPage}" Content="下一页" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>

                                <StackPanel x:Name="DownloadCommunityDetailView" IsVisible="False" Spacing="15">
                                    <Border Classes="pcl-card community-detail-card" Padding="12,10">
                                        <StackPanel Spacing="7">
                                            <ContentControl Content="{Binding SelectedCommunityResource}"
                                                            ContentTemplate="{StaticResource CommunityProjectRowTemplate}"
                                                            IsHitTestVisible="False" />

                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Command="{Binding OpenCommunityResourceCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Text="{Binding SelectedCommunityResource.Project.SourceDisplay}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Click="CommunityResourceCopyNameClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityCopyIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="复制名称" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Click="CommunityResourceCopyLinkClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityCopyIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="复制链接" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Command="{Binding TranslateCommunityDescriptionCommand}"
                                                        IsEnabled="{Binding CanTranslateCommunityDescription}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="翻译简介" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Tag="{Binding SelectedCommunityResource}"
                                                        Click="CommunityResourceFavoriteClick"
                                                        IsVisible="{Binding !SelectedCommunityResource.IsFavorite}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="收藏" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="community-detail-action" Margin="0,0,5,5"
                                                        Tag="{Binding SelectedCommunityResource}"
                                                        Click="CommunityResourceFavoriteClick"
                                                        IsVisible="{Binding SelectedCommunityResource.IsFavorite}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="14" Height="14" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                                                        <TextBlock VerticalAlignment="Center" Text="已收藏" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <Border Padding="12,10" Background="#F3F8FD" CornerRadius="4"
                                                    IsVisible="{Binding IsCommunityDescriptionTranslationPanelVisible}">
                                                <Grid MinHeight="70">
                                                    <controls:PclLoadingIndicator
                                                        IsVisible="{Binding IsCommunityDescriptionTranslationRunning}"
                                                        Text="正在获取简介译文" />
                                                    <StackPanel IsVisible="{Binding !IsCommunityDescriptionTranslationRunning}"
                                                                Spacing="8">
                                                        <TextBlock Foreground="#52708C"
                                                                   Text="{Binding CommunityDescriptionTranslationSummary}"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Spacing="3">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#798692" Text="原文" />
                                                            <TextBlock Foreground="#4E5D6B"
                                                                       Text="{Binding SelectedCommunityResource.Project.Description}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="3"
                                                                    IsVisible="{Binding HasCommunityDescriptionTranslation}">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#2472C8" Text="译文" />
                                                            <TextBlock Foreground="#364E64"
                                                                       Text="{Binding CommunityDescriptionTranslation}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="download-loading-card" Margin="0,35,0,35"
                                            IsVisible="{Binding IsCommunityVersionLoading}">
                                        <controls:PclLoadingIndicator Text="正在获取版本列表" />
                                    </Border>

                                    <Border Classes="pcl-card community-detail-card" Padding="0"
                                            IsVisible="{Binding IsCommunityVersionFilterVisible}">
                                        <StackPanel>
                                            <Grid Margin="10,10,10,5" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                                  IsVisible="{Binding IsCommunityGameVersionFilterVisible}">
                                                <TextBlock Margin="2,4,0,0" VerticalAlignment="Top"
                                                           FontSize="13" Foreground="#343D4A" Text="实例筛选：" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CommunityGameVersionFilters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CommunityResourceVersionFilterOption">
                                                            <RadioButton Classes="community-version-filter"
                                                                         GroupName="CommunityGameVersionFilter"
                                                                         Tag="{Binding}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         Click="CommunityVersionGameFilterClick"
                                                                         AutomationProperties.Name="{Binding DisplayName, StringFormat=筛选游戏版本 {0}}"
                                                                         Content="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <Grid Margin="10,5,10,10" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                                  IsVisible="{Binding IsCommunityLoaderVersionFilterVisible}">
                                                <TextBlock Margin="2,4,0,0" VerticalAlignment="Top"
                                                           FontSize="13" Foreground="#343D4A" Text="模组加载器筛选：" />
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CommunityLoaderVersionFilters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CommunityResourceVersionFilterOption">
                                                            <RadioButton Classes="community-version-filter"
                                                                         GroupName="CommunityLoaderVersionFilter"
                                                                         Tag="{Binding}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         Click="CommunityVersionLoaderFilterClick"
                                                                         AutomationProperties.Name="{Binding DisplayName, StringFormat=筛选加载器 {0}}"
                                                                         Content="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding CommunityResourceVersionGroups}"
                                                  IsVisible="{Binding HasCommunityResourceVersions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommunityResourceVersionGroupViewModel">
                                                <Border Classes="version-category-card" Margin="0,0,0,15">
                                                    <StackPanel>
                                                        <ToggleButton Classes="community-version-group-toggle"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                                           Text="{Binding Title, StringFormat={}{0}}" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Grid Width="18" Height="18">
                                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandDownIcon}" Stretch="Uniform"
                                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                              IsVisible="{Binding !IsExpanded}" />
                                                                        <Path Width="12" Height="7" Data="{StaticResource VersionExpandUpIcon}" Stretch="Uniform"
                                                                              Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                                              IsVisible="{Binding IsExpanded}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <ItemsControl Margin="12,0,12,10" ItemsSource="{Binding Versions}"
                                                                      IsVisible="{Binding IsExpanded}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="domain:CommunityResourceVersion">
                                                                    <Border MinHeight="58" Padding="5,6" BorderBrush="#E7EDF3" BorderThickness="0,0,0,1">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding VersionNumber}" />
                                                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#6F7C8B"
                                                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                                <TextBlock FontSize="11" Foreground="#526170"
                                                                                           Text="{Binding FileSummary}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" MinWidth="92" VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Right" Spacing="2">
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource PclThemePrimaryBrush}"
                                                                                           Text="{Binding ChannelDisplay}" />
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#526170"
                                                                                           Text="{Binding LoaderSummary}" />
                                                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#6F7C8B"
                                                                                           Text="{Binding PublishedAtDisplay}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="2" Classes="community-version-install" Tag="{Binding}"
                                                                                    VerticalAlignment="Center" Click="CommunityVersionDownloadClick"
                                                                                    AutomationProperties.Name="{Binding VersionNumber, StringFormat=下载 {0}}"
                                                                                    Content="下载" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Classes="pcl-status-strip" Background="#EDF6FF"
                                            IsVisible="{Binding !HasCommunityResourceVersions}">
                                        <TextBlock FontSize="12" Foreground="#365879"
                                                   Text="{Binding CommunityVersionSummary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="DownloadDeferredCard" Classes="pcl-card" Padding="20" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="DownloadDeferredTitle" FontSize="17" FontWeight="SemiBold" Text="安装包" />
                                    <TextBlock Foreground="#6F7C8B" Text="暂未开放" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPage" IsVisible="False">
                <Grid ColumnDefinitions="140,*" Background="#D9EAF9">
                    <Border Classes="pcl-page-left" Background="#FCFCFD" Padding="0,12,0,0" BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Category structure follows PCL-CE PageSetupLeft.xaml; visual treatment follows PCL2. -->
                            <StackPanel x:Name="SettingsNavigationPanel" Spacing="2">
                                <TextBlock Margin="13,0,5,3" FontSize="12" Foreground="#6F7C8B" Text="游戏" />
                                <controls:PclNavigationButton Classes="secondary-navigation selected" Click="SettingsNavigationClick" Tag="launch" Label="启动"
                                                              IconData="M5 5a2 2 0 0 1 3-1.73l12 7a2 2 0 0 1 0 3.46l-12 7A2 2 0 0 1 5 19z" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="java" Label="Java"
                                                              IconData="M10 2v2 M14 2v2 M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1 M6 2v2" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="manage" Label="管理"
                                                              IconData="M10 2v8l3-3 3 3V2 M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="工具" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="link" Label="联机"
                                                              IconData="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="启动器" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="interface" Label="个性化"
                                                              IconData="M12 22a10 10 0 1 0 0-20 7 7 0 0 0 0 14h1.5a2.5 2.5 0 0 1 0 5z M7.5 10h.01 M12 7h.01 M16.5 10h.01" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="language" Label="语言"
                                                              IconData="M5 8l6 6 M4 14l6-7 2-3 M2 5h12 M12 22l4-9 4 9 M14 18h4" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="misc" Label="杂项"
                                                              IconData="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6" />
                                <TextBlock Margin="13,8,5,3" FontSize="12" Foreground="#6F7C8B" Text="关于" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="about" Label="软件信息"
                                                              IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="update" Label="软件更新"
                                                              IconData="M21 12a9 9 0 1 1-3-6.7 M21 3v6h-6" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="feedback" Label="反馈"
                                                              IconData="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                                <controls:PclNavigationButton Classes="secondary-navigation" Click="SettingsNavigationClick" Tag="log" Label="查看日志"
                                                              IconData="M4 2h16v20H4z M8 7h8 M8 11h8 M8 15h5" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Column="1" Classes="pcl-page-right" Background="#D9EAF9">
                    <StackPanel Margin="25,25,25,10" Spacing="15">

                        <StackPanel x:Name="SettingsLaunchSection" Classes="setup-launch-section" Spacing="15">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="启动选项" />
                                    <Grid Grid.Row="1" Margin="25,0,25,15"
                                          ColumnDefinitions="Auto,*"
                                          RowDefinitions="28,9,28,9,28,9,28,9,28,9,28,9,28,9,28">
                                        <TextBlock Classes="setup-launch-label" Text="默认实例隔离" />
                                        <ComboBox Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding InstanceIsolationModes}"
                                                  SelectedItem="{Binding SelectedInstanceIsolationMode}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Classes="setup-launch-label" Text="游戏窗口标题" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="setup-launch-field"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  PlaceholderText="默认"
                                                  SelectedIndex="-1" Text="{Binding WindowTitle}">
                                            <ComboBoxItem Content="{}{name} | 玩家：{user} | 使用 {login} 登录" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Classes="setup-launch-label" Text="自定义信息" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Classes="setup-launch-field"
                                                 MaxLength="4000" Text="{Binding CustomInfo}" />

                                        <TextBlock Grid.Row="6" Classes="setup-launch-label" Text="启动器可见性" />
                                        <ComboBox Grid.Row="6" Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding LauncherVisibilityModes}"
                                                  SelectedItem="{Binding SelectedLauncherVisibility}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="8" Classes="setup-launch-label" Text="进程优先级" />
                                        <ComboBox Grid.Row="8" Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding GameProcessPriorities}"
                                                  SelectedItem="{Binding SelectedGameProcessPriority}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="10" Classes="setup-launch-label" Text="窗口大小" />
                                        <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto">
                                            <ComboBox x:Name="GameWindowModeSelector" Classes="setup-launch-field"
                                                      AutomationProperties.Name="Minecraft 窗口模式"
                                                      ItemsSource="{Binding GameWindowModes}"
                                                      SelectedItem="{Binding SelectedGameWindowMode}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Classes="setup-launch-field" Margin="50,0,0,0" Width="60"
                                                     IsVisible="{Binding UsesCustomGameWindowSize}"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="自定义 Minecraft 窗口宽度"
                                                     Text="{Binding CustomGameWindowWidth}" />
                                            <TextBlock Grid.Column="2" Margin="7,0" VerticalAlignment="Center"
                                                       IsVisible="{Binding UsesCustomGameWindowSize}" Text="×" />
                                            <TextBox Grid.Column="3" Classes="setup-launch-field" Width="60"
                                                     IsVisible="{Binding UsesCustomGameWindowSize}"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="自定义 Minecraft 窗口高度"
                                                     Text="{Binding CustomGameWindowHeight}" />
                                        </Grid>

                                        <TextBlock Grid.Row="12" Classes="setup-launch-label" Text="正版验证方式" />
                                        <ComboBox Grid.Row="12" Grid.Column="1" Classes="setup-launch-field" SelectedIndex="0" IsEnabled="False">
                                            <ComboBoxItem Content="设备代码流" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="14" Classes="setup-launch-label" Text="IP 协议偏好" />
                                        <ComboBox Grid.Row="14" Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding PreferredIpStacks}"
                                                  SelectedItem="{Binding SelectedPreferredIpStack}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="游戏内存" />
                                    <StackPanel Grid.Row="1" Margin="25,0,25,15">
                                        <Grid Margin="0,0,0,3" ColumnDefinitions="110,*"
                                              RowDefinitions="28,9,28,9">
                                            <RadioButton Classes="setup-memory-mode" GroupName="MemoryAllocation"
                                                         IsChecked="{Binding UsesAutomaticMemoryAllocation, Mode=OneWay}"
                                                         Content="自动配置" Click="MemoryAutoClick" />
                                            <RadioButton Grid.Row="2" Classes="setup-memory-mode" GroupName="MemoryAllocation"
                                                         IsChecked="{Binding UsesCustomMemoryAllocation, Mode=OneWay}"
                                                         Content="自定义" Click="MemoryCustomClick" />
                                            <Slider Grid.Row="2" Grid.Column="1" Height="28"
                                                    IsEnabled="{Binding UsesCustomMemoryAllocation}"
                                                    Minimum="0" Maximum="{Binding CustomMemorySliderMaximum}"
                                                    Value="{Binding CustomMemorySliderValue}"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </Grid>

                                        <Grid Margin="0,11,2,0" RowDefinitions="Auto,4,Auto">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding MemoryUsedWidth}" />
                                                <ColumnDefinition Width="{Binding MemoryGameWidth}" />
                                                <ColumnDefinition Width="{Binding MemoryEmptyWidth}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.ColumnSpan="3" Margin="2,0,0,5" FontSize="11"
                                                       Opacity="0.7" Text="已使用 / 总内存" />
                                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Margin="2,0,0,5" FontSize="11"
                                                       Opacity="0.7" Text="游戏分配" />
                                            <Border Grid.Row="1" Background="#5D7287" />
                                            <Border Grid.Row="1" Grid.Column="1" Background="#79B8F3" />
                                            <Border Grid.Row="1" Grid.Column="2" Background="#D4E6F8" />
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="2,3,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontSize="16" Foreground="#287DCE" Text="{Binding MemoryUsedDisplay}" />
                                                <TextBlock FontSize="16" Foreground="#287DCE" Text="{Binding MemoryTotalDisplay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,3,0,0"
                                                       FontSize="16" Foreground="#287DCE" Text="{Binding MemoryGameDisplay}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <controls:PclCollapsibleCard Title="高级启动选项" IsExpanded="False">
                                <controls:PclCollapsibleCard.Body>
                                    <Grid Margin="25,0,25,15" ColumnDefinitions="Auto,*"
                                          RowDefinitions="28,9,100,9,28,9,28,Auto,Auto">
                                        <TextBlock Classes="setup-launch-label" Text="渲染器" />
                                        <ComboBox Grid.Column="1" Classes="setup-launch-field"
                                                  IsEnabled="{Binding IsRendererSelectionSupported}"
                                                  ItemsSource="{Binding RendererModes}"
                                                  SelectedItem="{Binding SelectedRendererMode}">
                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <StackPanel Grid.Row="2" Margin="0,0,25,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock VerticalAlignment="Center" Text="JVM 参数头部" />
                                            <Button Width="24" Height="24" Padding="0" Background="Transparent"
                                                    Command="{Binding ResetJvmArgumentsCommand}" ToolTip.Tip="恢复默认">
                                                <Path Width="14" Height="14" Data="M3 12a9 9 0 1 0 3-6.7 M3 3v6h6"
                                                      Fill="Transparent" Stroke="#526273" StrokeThickness="1.8"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                        <TextBox Grid.Row="2" Grid.Column="1" Classes="setup-launch-editor"
                                                 Height="100" MaxLength="4000"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" Padding="8,6"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding AdditionalJvmArguments}" />

                                        <TextBlock Grid.Row="4" Classes="setup-launch-label" Text="游戏参数尾部" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Classes="setup-launch-field"
                                                 MaxLength="4000" Text="{Binding AdditionalGameArguments}" />

                                        <TextBlock Grid.Row="6" Classes="setup-launch-label" Text="启动前执行命令" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Classes="setup-launch-field"
                                                 MaxLength="4000" Text="{Binding PreLaunchCommand}" />
                                        <CheckBox Grid.Row="7" Grid.Column="1" Height="28" Margin="0,8,0,7"
                                                  IsVisible="{Binding HasPreLaunchCommand}"
                                                  IsChecked="{Binding WaitForPreLaunchCommand}"
                                                  Content="等待命令执行完成后再继续启动" />

                                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,12,0,4" Spacing="0">
                                            <CheckBox Height="28" IsChecked="{Binding DisableJavaLaunchWrapper}" Content="禁用 Java Launch Wrapper" />
                                            <CheckBox Height="28" IsChecked="{Binding DisableLegacyFix}" Content="禁用 LegacyFix" />
                                            <CheckBox Height="28" IsEnabled="{Binding IsWindowsLaunchOptionSupported}"
                                                      IsChecked="{Binding PreferDedicatedGpu}" Content="要求 Java 使用高性能显卡" />
                                            <CheckBox Height="28" IsEnabled="{Binding IsWindowsLaunchOptionSupported}"
                                                      IsChecked="{Binding UseJavaExecutable}" Content="使用 java.exe 而不是 javaw.exe" />
                                            <CheckBox Height="28" IsChecked="{Binding DisableLwjglUnsafeAgent}" Content="禁用 LWJGL Unsafe Agent" />
                                            <CheckBox Height="28" IsChecked="{Binding DisableCrashAnalysis}" Content="禁用自动崩溃分析" />
                                            <CheckBox Height="28" IsChecked="{Binding LockMemory}" Content="锁定内存分配（-Xms = -Xmx）" />
                                        </StackPanel>
                                    </Grid>
                                </controls:PclCollapsibleCard.Body>
                            </controls:PclCollapsibleCard>
                        </StackPanel>

                        <StackPanel x:Name="SettingsJavaSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="Java 操作" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Orientation="Horizontal" Spacing="10">
                                        <Button MinWidth="110" IsEnabled="False" Content="添加 Java" />
                                        <Button MinWidth="110" Command="{Binding RefreshCommand}" Content="自动搜索" />
                                        <TextBlock VerticalAlignment="Center" Classes="setup-muted" Text="仅列出与当前系统架构兼容且可执行的 Java。" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="Java 列表" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="10">
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Text="操作系统" /><TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" />
                                            <TextBlock Grid.Row="1" Text="系统架构" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                                            <TextBlock Grid.Row="2" Text=".NET 运行时" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" />
                                            <TextBlock Grid.Row="3" Text="Java 状态" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding JavaSummary}" TextWrapping="Wrap" />
                                        </Grid>
                                        <ComboBox x:Name="SettingsJavaSelector" MinWidth="360" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding HasAvailableJavaInstallations}"
                                                  ItemsSource="{Binding AvailableJavaInstallations}"
                                                  SelectedItem="{Binding SelectedJava}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                        <TextBlock Grid.Column="1" Foreground="#6F7C8B" Text="{Binding Vendor}" />
                                                        <TextBlock Grid.Column="2" Foreground="#6F7C8B" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ItemsControl ItemsSource="{Binding AvailableJavaInstallations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#D8E2EC" BorderThickness="0,1,0,0" Padding="4,9">
                                                        <Grid ColumnDefinitions="90,130,*" ColumnSpacing="10">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                            <TextBlock Grid.Column="1" Foreground="#536272" Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="#6F7C8B" Text="{Binding ExecutablePath}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Direct Avalonia adaptation of the PCL-CE PageSetup page family. -->
                        <StackPanel x:Name="SettingsManageSection" Classes="setup-launch-section setup-manage-section" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="游戏资源获取行为" />
                                    <Grid Grid.Row="1" Margin="25,0,25,15" ColumnDefinitions="Auto,*"
                                          RowDefinitions="28,7,28,7,27,27,Auto,27">
                                        <TextBlock Classes="setup-launch-label" Text="文件下载源" />
                                        <ComboBox Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding FileSourceOptions}"
                                                  SelectedItem="{Binding SelectedFileSource}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Classes="setup-launch-label" Text="版本列表源" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Classes="setup-launch-field"
                                                  ItemsSource="{Binding VersionListSourceOptions}"
                                                  SelectedItem="{Binding SelectedVersionListSource}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="4" Classes="setup-launch-label" Text="下载线程" />
                                        <Slider Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="256"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedDownloadConcurrency}"
                                                ToolTip.Tip="{Binding DownloadConcurrencyDisplay}" />

                                        <TextBlock Grid.Row="5" Classes="setup-launch-label" Text="下载速度限制" />
                                        <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="42"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedDownloadSpeedLimitStep}"
                                                ToolTip.Tip="{Binding DownloadSpeedLimitDisplay}" />

                                        <TextBlock Grid.Row="6" Classes="setup-launch-label" VerticalAlignment="Top"
                                                   Margin="0,5,25,5" Text="目标文件夹" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,5"
                                                   VerticalAlignment="Center" Opacity="0.5"
                                                   Text="在开始下载前由用户选择" />

                                        <TextBlock Grid.Row="7" Margin="0,5,25,0" Text="安装行为" />
                                        <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,*">
                                            <CheckBox Height="22" IsChecked="{Binding AutoSelectNewInstance}"
                                                      Content="安装新实例后自动选定该实例" />
                                            <CheckBox Grid.Column="1" Height="22" IsChecked="{Binding FixAuthlib}"
                                                      Content="升级部分版本的 Authlib"
                                                      ToolTip.Tip="安装部分旧版本时更新存在兼容问题的 Authlib" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="社区资源获取行为" />
                                    <StackPanel Grid.Row="1" Margin="25,0,25,12">
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="28,7,28,7,28,7,28,7">
                                            <TextBlock Classes="setup-launch-label" Text="下载源" />
                                            <ComboBox Grid.Column="1" Classes="setup-launch-field"
                                                      ItemsSource="{Binding CommunitySourceOptions}"
                                                      SelectedItem="{Binding SelectedCommunitySource}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Row="2" Classes="setup-launch-label" Text="文件名格式" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" Classes="setup-launch-field"
                                                      ItemsSource="{Binding CommunityFileNameFormatOptions}"
                                                      SelectedItem="{Binding SelectedCommunityFileNameFormat}"
                                                      ToolTip.Tip="修改社区资源下载后的文件名格式">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Row="4" Classes="setup-launch-label" Text="模组管理样式" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" Classes="setup-launch-field"
                                                      ItemsSource="{Binding CommunityModNameStyleOptions}"
                                                      SelectedItem="{Binding SelectedCommunityModNameStyle}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Row="6" Classes="setup-launch-label" Text="快速下载行为" />
                                            <ComboBox Grid.Row="6" Grid.Column="1" Classes="setup-launch-field"
                                                      ItemsSource="{Binding CommunityQuickDownloadBehaviorOptions}"
                                                      SelectedItem="{Binding SelectedCommunityQuickDownloadBehavior}"
                                                      ToolTip.Tip="设置资源列表中下载按钮的默认行为">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox Height="22" Margin="0,2,0,4" IsChecked="{Binding IgnoreQuilt}"
                                                  Content="不显示 Quilt 加载器"
                                                  ToolTip.Tip="在社区资源筛选中隐藏 Quilt" />
                                        <CheckBox Height="22" Margin="0,2,0,4" IsChecked="{Binding AutoInstallDependencies}"
                                                  Content="下载模组时自动检查并安装必需前置"
                                                  ToolTip.Tip="下载模组前解析并一并下载必要依赖" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="辅助功能" />
                                    <Grid Grid.Row="1" Margin="25,0,25,17"
                                          ColumnDefinitions="Auto,160,Auto"
                                          RowDefinitions="22,8,22,8,22,8">
                                        <TextBlock Classes="setup-launch-label" Text="游戏更新提示" />
                                        <CheckBox Grid.Column="1" Height="22" IsChecked="{Binding ReleaseNotifications}"
                                                  Content="正式版更新提示" />
                                        <CheckBox Grid.Column="2" Height="22" IsChecked="{Binding SnapshotNotifications}"
                                                  Content="测试版更新提示" />

                                        <TextBlock Grid.Row="2" Classes="setup-launch-label" Text="游戏语言" />
                                        <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="22"
                                                  IsChecked="{Binding AutoChangeGameLanguage}"
                                                  Content="自动设置为启动器语言" />

                                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Height="22"
                                                  IsChecked="{Binding ReadClipboard}"
                                                  Content="识别跳转剪贴板中的社区资源链接"
                                                  ToolTip.Tip="识别剪贴板中的 Modrinth 与 CurseForge 资源链接" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsLinkSection" IsVisible="False">
                            <Border Classes="setup-card" MinHeight="350">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Width="70" Height="70" CornerRadius="35" Background="#E1F0FF">
                                            <Path Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                                  Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PclThemePrimaryBrush}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="#344150" Text="敬请期待" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#6F7C8B"
                                                   Text="PCL Aurora 的联机功能正在准备中。" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsInterfaceSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="启动器" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="9">
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="界面不透明度" />
                                            <Slider Grid.Column="1" Minimum="40" Maximum="100" Value="100" IsEnabled="False" />
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="主题" />
                                            <ComboBox x:Name="ThemeModeSelector" Grid.Row="1" Grid.Column="1"
                                                      AutomationProperties.Name="主题模式"
                                                      ItemsSource="{Binding ThemeModes}"
                                                      SelectedItem="{Binding SelectedThemeMode}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="亮色主题色" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="1" IsEnabled="False">
                                                <ComboBoxItem Content="天蓝" /><ComboBoxItem Content="龙猫蓝" /><ComboBoxItem Content="死亡蓝" />
                                            </ComboBox>
                                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="暗色主题色" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="1" IsEnabled="False">
                                                <ComboBoxItem Content="天蓝" /><ComboBoxItem Content="龙猫蓝" /><ComboBoxItem Content="死亡蓝" />
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox IsChecked="True" IsEnabled="False" Content="显示启动器标志" />
                                        <CheckBox IsEnabled="False" Content="锁定窗口大小" />
                                        <CheckBox IsChecked="True" IsEnabled="False" Content="在启动时显示趣味提示" />
                                        <CheckBox IsEnabled="False" Content="启用高级背景材质" />
                                        <TextBlock Classes="setup-muted" Text="{Binding ThemeSummary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="字体" />
                                    <Grid Grid.Row="1" Margin="18,0,18,16" ColumnDefinitions="155,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="全局字体" />
                                        <ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="默认（HarmonyOS Sans SC）" /></ComboBox>
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="MOTD 字体" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="跟随全局字体" /></ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="背景" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="9" IsEnabled="False">
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="内容适应" />
                                            <ComboBox Grid.Column="1" SelectedIndex="0">
                                                <ComboBoxItem Content="智能适应" /><ComboBoxItem Content="居中" /><ComboBoxItem Content="适应窗口" />
                                                <ComboBoxItem Content="拉伸" /><ComboBoxItem Content="平铺" />
                                            </ComboBox>
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="背景不透明度" />
                                            <Slider Grid.Row="1" Grid.Column="1" Maximum="100" Value="100" />
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="背景模糊" />
                                            <Slider Grid.Row="2" Grid.Column="1" Maximum="40" Value="0" />
                                        </Grid>
                                        <CheckBox IsChecked="True" Content="播放视频背景时自动暂停" />
                                        <CheckBox IsChecked="True" Content="使用主题色覆盖背景" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="打开文件夹" /><Button Content="刷新背景" /><Button Content="清空背景" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="背景音乐" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="8" IsEnabled="False">
                                        <Grid ColumnDefinitions="155,*"><TextBlock VerticalAlignment="Center" Text="音量" /><Slider Grid.Column="1" Maximum="100" Value="50" /></Grid>
                                        <CheckBox IsChecked="True" Content="随机播放" /><CheckBox IsChecked="True" Content="启动器打开时自动播放" />
                                        <CheckBox Content="进入游戏后继续播放" /><CheckBox Content="进入游戏后停止播放" />
                                        <CheckBox IsChecked="True" Content="启用系统媒体控制" />
                                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="打开文件夹" /><Button Content="刷新音乐" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsLanguageSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="语言" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="10">
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="9" IsEnabled="False">
                                            <TextBlock VerticalAlignment="Center" Text="界面语言" />
                                            <ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="English (US)" /></ComboBox>
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="区域格式" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="简体中文（中国）" /></ComboBox>
                                        </Grid>
                                        <Border Classes="setup-hint"><TextBlock TextWrapping="Wrap" Text="目前仅部分新增界面支持多语言功能，其余界面将在后续迁移中逐步完成生效。迁移期间优先确保简体中文与 English (US) 可用。" /></Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsMiscSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="系统" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="9" IsEnabled="False">
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="启动器公告" />
                                            <ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="显示所有公告" /><ComboBoxItem Content="仅在有重要通知时显示公告" /><ComboBoxItem Content="关闭所有公告" /></ComboBox>
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="最高动画帧率" />
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="60" Value="60" />
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="实时日志行数" />
                                            <Slider Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="5000" Value="500" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                            <CheckBox Content="禁用硬件加速" /><CheckBox Grid.Column="1" Content="启用遥测数据收集" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="导出设置" /><Button Content="导入设置" /><Button Content="停止使用 PCL Aurora" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="网络" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="9" IsEnabled="False">
                                        <CheckBox IsChecked="True" Content="使用 DoH 解析地址" />
                                        <Grid ColumnDefinitions="155,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="HTTP 代理" />
                                            <ComboBox Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="不使用代理" /><ComboBoxItem Content="使用系统代理" /><ComboBoxItem Content="自定义代理" /></ComboBox>
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="代理地址" />
                                            <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="例如 http://127.0.0.1:1080/" />
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="代理身份" />
                                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox PlaceholderText="用户名（可选）" /><TextBox Grid.Column="1" PlaceholderText="密码（可选）" /></Grid>
                                        </Grid>
                                        <Button HorizontalAlignment="Left" Content="应用代理" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="调试选项" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="8" IsEnabled="False">
                                        <Grid ColumnDefinitions="155,*"><TextBlock VerticalAlignment="Center" Text="动画速度" /><Slider Grid.Column="1" Maximum="30" Value="9" /></Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><CheckBox Content="禁止在下载时从其他文件夹复制文件" /><CheckBox Grid.Column="1" Content="调试模式" /><CheckBox Grid.Column="2" Content="添加延迟" /></Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsAboutSection" Classes="about-section" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="关于" />
                                    <StackPanel Grid.Row="1" Margin="21,0,21,16">
                                        <Border Classes="about-item">
                                            <Grid ColumnDefinitions="46,*,150">
                                                <Border Classes="about-avatar">
                                                    <Image Source="/Assets/About/LTCat.jpg" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Classes="about-item-title" Text="龙腾猫跃" />
                                                    <TextBlock Classes="setup-muted" Text="Plain Craft Launcher 的原作者" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="about-action"
                                                        Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl-sponsor"
                                                        Content="赞助原作者" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="about-item">
                                            <Grid ColumnDefinitions="46,*,150">
                                                <Border Classes="about-avatar" CornerRadius="3">
                                                    <Image Source="/Assets/About/PclCommunity.png" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Classes="about-item-title" Text="PCL Community" />
                                                    <TextBlock Classes="setup-muted" Text="Plain Craft Launcher Community Edition 的开发团队" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="about-action"
                                                        Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl-community"
                                                        Content="GitHub 主页" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="about-item">
                                            <Grid ColumnDefinitions="46,*,150">
                                                <Border Classes="about-avatar">
                                                    <Image Source="/Assets/About/MicroATP.png" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Classes="about-item-title" Text="Micro-ATP" />
                                                    <TextBlock Classes="setup-muted" Text="PCL Aurora 作者" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="about-action"
                                                        Command="{Binding OpenProjectPageCommand}" CommandParameter="author"
                                                        Content="GitHub 主页" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="about-item">
                                            <Grid ColumnDefinitions="46,*,150">
                                                <Border Classes="about-avatar" CornerRadius="3">
                                                    <Image Source="/Assets/Icons/AppIcon-2048.png" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Classes="about-item-title" Text="PCL Aurora" />
                                                    <TextBlock Classes="setup-muted" Text="项目仓库" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="about-action"
                                                        Command="{Binding OpenProjectPageCommand}" CommandParameter="source"
                                                        Content="查看源代码" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="特别鸣谢" />
                                    <Grid Grid.Row="1" Margin="21,0,21,16" ColumnDefinitions="46,*,150"
                                          RowDefinitions="52,52,52,52">
                                        <Border Grid.Row="0" Classes="about-avatar">
                                            <Image Source="/Assets/About/Bangbang93.png" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" Text="bangbang93" />
                                            <TextBlock Classes="setup-muted" Text="提供 BMCLAPI 下载镜像服务" />
                                        </StackPanel>
                                        <Button Grid.Row="0" Grid.Column="2" Classes="about-action"
                                                Command="{Binding OpenProjectPageCommand}" CommandParameter="bmclapi-sponsor"
                                                Content="赞助镜像源" />

                                        <Border Grid.Row="1" Classes="about-avatar">
                                            <Image Source="/Assets/About/McmodWiki.png" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" Text="MC 百科" />
                                            <TextBlock Classes="setup-muted" Text="提供社区资源中文名称数据" />
                                        </StackPanel>
                                        <Button Grid.Row="1" Grid.Column="2" Classes="about-action"
                                                Command="{Binding OpenProjectPageCommand}" CommandParameter="mcmod"
                                                Content="打开百科" />

                                        <Border Grid.Row="2" Classes="about-avatar">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                                                       FontWeight="SemiBold" Foreground="{StaticResource PclThemePrimaryBrush}" Text="M" />
                                        </Border>
                                        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" Text="Modrinth" />
                                            <TextBlock Classes="setup-muted" Text="提供模组、整合包及其他社区资源目录" />
                                        </StackPanel>
                                        <Button Grid.Row="2" Grid.Column="2" Classes="about-action"
                                                Command="{Binding OpenProjectPageCommand}" CommandParameter="modrinth"
                                                Content="打开网站" />

                                        <Border Grid.Row="3" Classes="about-avatar">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                                                       FontWeight="SemiBold" Foreground="{StaticResource PclThemePrimaryBrush}" Text="C" />
                                        </Border>
                                        <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontSize="15" Text="CurseForge" />
                                            <TextBlock Classes="setup-muted" Text="提供世界资源目录与文件信息" />
                                        </StackPanel>
                                        <Button Grid.Row="3" Grid.Column="2" Classes="about-action"
                                                Command="{Binding OpenProjectPageCommand}" CommandParameter="curseforge"
                                                Content="打开网站" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="贡献者" />
                                    <StackPanel Grid.Row="1" Margin="17,0,17,16" Spacing="7">
                                        <TextBlock HorizontalAlignment="Center" Margin="0,12" Classes="setup-muted"
                                                   IsVisible="{Binding !HasContributors}" Text="{Binding ContributorSummary}" />
                                        <ItemsControl ItemsSource="{Binding Contributors}" IsVisible="{Binding HasContributors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GitHubContributorItemViewModel">
                                                    <Button Classes="contributor-item" Tag="{Binding ProfileUri}" Click="ContributorClick"
                                                            ToolTip.Tip="{Binding Login}">
                                                        <StackPanel HorizontalAlignment="Center" Spacing="5">
                                                            <Border Classes="about-avatar">
                                                                <Grid>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               FontSize="15" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource PclThemePrimaryBrush}"
                                                                               IsVisible="{Binding !HasAvatar}" Text="{Binding Initial}" />
                                                                    <Image Width="36" Height="36" Stretch="UniformToFill"
                                                                           IsVisible="{Binding HasAvatar}" Source="{Binding Avatar}" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock MaxWidth="78" HorizontalAlignment="Center" FontSize="12"
                                                                       Text="{Binding Login}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#7B8794"
                                                                       Text="{Binding Contributions, StringFormat={}{0} 次贡献}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource PclThemePrimaryBrush}"
                                                Command="{Binding OpenProjectPageCommand}" CommandParameter="contributors"
                                                Content="查看完整贡献记录" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <controls:PclCollapsibleCard Margin="0,0,0,15"
                                                         Title="版权声明与法律信息"
                                                         IsExpanded="True">
                                <controls:PclCollapsibleCard.Body>
                                    <StackPanel Margin="25,5,23,20" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="隐私说明" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="PCL Aurora 将启动器设置、社区收藏和运行日志保存在本机。Microsoft 登录刷新令牌由当前系统的安全凭据库保存，普通偏好文件只记录显示账户所需的名称与 UUID。Aurora 不设自营账户服务器，也不收集遥测、设备调查或使用统计数据。" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="联网与反馈" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="当你使用正版登录、游戏与社区资源下载、更新检查或查看贡献者时，应用会连接 Microsoft、Minecraft、GitHub、Modrinth、CurseForge、BMCLAPI 等对应第三方服务，并受各服务自身政策约束。PCL Aurora 的 User Agent 仅用于向目标服务标识应用名称与版本；问题信息只会在你主动打开 GitHub Issues 并提交后发送。" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="其他信息" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="Copyright © 2026 Micro-ATP. All Rights Reserved.&#xA;PCL Aurora 是基于 Plain Craft Launcher 与 PCL Community Edition 的第三方跨平台迁移项目。Micro-ATP 独立实现的新增内容适用仓库根目录的严格专有迁移许可证；PCL、PCL-CE 与第三方来源内容仍按各自许可证处理。&#xA;非 Minecraft 官方产品，未经 Mojang 或 Microsoft 批准，也不与 Mojang 或 Microsoft 关联。" />
                                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="source" Content="Aurora 源代码" />
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="license" Content="根许可证" />
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="notice" Content="NOTICE" />
                                        </WrapPanel>
                                    </StackPanel>
                                </controls:PclCollapsibleCard.Body>
                            </controls:PclCollapsibleCard>

                            <controls:PclCollapsibleCard Margin="0,0,0,15"
                                                         Title="上游版权与法律信息"
                                                         IsExpanded="False">
                                <controls:PclCollapsibleCard.Body>
                                    <StackPanel Margin="25,5,23,20" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="Plain Craft Launcher" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="上游 PCL 的 User Agent 中包含启动器版本号，用于统计各版本的用户数量；除该上游行为外，PCL 声明不会向其开发者上传其他信息。此段仅说明 PCL 的上游实现，不代表 PCL Aurora 进行同类统计。" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="版权与登记信息" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="Copyright © 龙腾猫跃 2016. All Rights Reserved.&#xA;计算机软件著作权登记号：2020SR0875133&#xA;违法违规行为举报投诉邮箱：hexdragon@vip.qq.com&#xA;非 Minecraft 官方产品，未经 Mojang 或 Microsoft 批准，也不与 Mojang 或 Microsoft 关联。" />
                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="PCL Community Edition" />
                                        <TextBlock LineHeight="18" TextWrapping="Wrap"
                                                   Text="Copyright © 2026 PCL Community &amp; 龙腾猫跃. PCL Aurora 迁移、适配或直接复用的 PCL 与 PCL-CE 代码、界面和资源继续受对应专门许可证约束；Aurora 的根许可证不重新授权这些上游内容。" />
                                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl-terms" Content="用户协议与免责声明" />
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl" Content="PCL 源代码" />
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl-ce" Content="PCL-CE 源代码" />
                                            <Button Classes="about-action" Margin="0,0,10,8" Command="{Binding OpenProjectPageCommand}" CommandParameter="pcl-ce-license" Content="PCL-CE 专门许可" />
                                        </WrapPanel>
                                    </StackPanel>
                                </controls:PclCollapsibleCard.Body>
                            </controls:PclCollapsibleCard>

                            <controls:PclCollapsibleCard Margin="0,0,0,15"
                                                         Title="许可与版权声明"
                                                         IsExpanded="False">
                                <controls:PclCollapsibleCard.Body>
                                    <ItemsControl Margin="25,2,23,4" ItemsSource="{Binding LicenseEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LicenseEntryViewModel">
                                                <Grid Margin="0,0,0,8"
                                                      ColumnDefinitions="145,20,*"
                                                      RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2"
                                                               LineHeight="18"
                                                               Text="{Binding Information}"
                                                               TextWrapping="Wrap" />
                                                    <WrapPanel Grid.Row="1" Grid.Column="2" Margin="0,7,0,4" Orientation="Horizontal">
                                                        <Button Classes="about-action"
                                                                MinWidth="120"
                                                                Margin="0,0,10,8"
                                                                IsVisible="{Binding HasWebsite}"
                                                                Tag="{Binding WebsiteTarget}"
                                                                Click="ProjectPageLinkClick"
                                                                Content="查看来源网站" />
                                                        <Button Classes="about-action"
                                                                MinWidth="120"
                                                                Margin="0,0,10,8"
                                                                IsVisible="{Binding HasLicense}"
                                                                Tag="{Binding LicenseTarget}"
                                                                Click="ProjectPageLinkClick"
                                                                Content="查看许可文档" />
                                                    </WrapPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </controls:PclCollapsibleCard.Body>
                            </controls:PclCollapsibleCard>
                        </StackPanel>

                        <StackPanel x:Name="SettingsUpdateSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="更新设置" />
                                    <Grid Grid.Row="1" Margin="18,0,18,16" ColumnDefinitions="155,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8" IsEnabled="False">
                                        <TextBlock VerticalAlignment="Center" Text="更新通道" /><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="正式版 / Release" /><ComboBoxItem Content="测试版 / Beta" /><ComboBoxItem Content="开发版 / Dev" /></ComboBox>
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="自动更新设置" /><ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="1"><ComboBoxItem Content="自动下载并安装更新" /><ComboBoxItem Content="自动下载并提示更新" /><ComboBoxItem Content="提示更新" /><ComboBoxItem Content="不自动检查更新（不推荐）" /></ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="当前版本" />
                                    <Grid Grid.Row="1" Margin="18,0,18,16" ColumnDefinitions="64,*,Auto">
                                        <Image Width="50" Height="50" Source="/Assets/Icons/AppIcon-2048.png" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding LauncherVersionDisplay}" /><TextBlock Classes="setup-muted" Text="{Binding AuroraReleaseSummary}" /></StackPanel>
                                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding OpenAuroraReleasesCommand}" Content="检查更新" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsFeedbackSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="提交反馈" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="12">
                                        <TextBlock TextWrapping="Wrap" Text="提交前请先搜索是否已有相同问题，并确认问题仍能在当前版本中复现。" />
                                        <Button HorizontalAlignment="Left" Command="{Binding OpenProjectPageCommand}" CommandParameter="issues" Content="前往反馈" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="反馈列表" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="8">
                                        <TextBlock Classes="setup-muted" Text="PCL Aurora 的公开问题、功能建议与处理状态均在 GitHub Issues 中维护。" />
                                        <Button HorizontalAlignment="Left" Command="{Binding OpenProjectPageCommand}" CommandParameter="issues" Content="查看全部反馈" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsLogSection" IsVisible="False">
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="日志操作" />
                                    <WrapPanel Grid.Row="1" Margin="18,0,18,16" ItemHeight="34">
                                        <Button MinWidth="100" Margin="0,0,10,0" IsEnabled="False" Content="导出日志" />
                                        <Button MinWidth="120" Margin="0,0,10,0" IsEnabled="False" Content="导出全部日志" />
                                        <Button MinWidth="120" Margin="0,0,10,0" Command="{Binding OpenApplicationDataDirectoryCommand}" Content="打开日志文件夹" />
                                        <Button MinWidth="120" Command="{Binding ClearGameLogsCommand}" IsEnabled="{Binding HasGameLogLines}" Content="清理历史日志" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setup-card">
                                <Grid RowDefinitions="40,*">
                                    <TextBlock Classes="setup-card-title" Text="全部日志" />
                                    <StackPanel Grid.Row="1" Margin="18,0,18,16" Spacing="8">
                                        <TextBlock Classes="setup-muted" Text="{Binding GameLogSummary}" />
                                        <Border MinHeight="160" MaxHeight="420" Background="#F7F9FB" BorderBrush="#D9E2EB" BorderThickness="1" CornerRadius="3" Padding="10">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding GameLogLines}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock FontFamily="Menlo,Consolas,monospace" FontSize="11" Foreground="#4B5563" Text="{Binding DisplayText}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="MorePage" IsVisible="False">
                <Grid ColumnDefinitions="152,*" Background="#D9EAF9">
                    <Border Classes="pcl-page-left" Background="#FCFCFD" Padding="0,12,0,0" BorderBrush="#D1DDEA" BorderThickness="0,0,1,0">
                        <!-- PCL2 PageOtherLeft.xaml structure, plus PCL-CE/Aurora session log access. -->
                        <StackPanel x:Name="MoreNavigationPanel" Spacing="2">
                            <controls:PclNavigationButton Classes="secondary-navigation selected" Click="MoreNavigationClick" Tag="help" Label="帮助"
                                                          IconData="M9.1 9a3 3 0 1 1 5.83 1c0 2-3 2-3 4 M12 18h.01 M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="about" Label="关于与鸣谢"
                                                          IconData="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8h.01" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="toolbox" Label="百宝箱"
                                                          IconData="M3 6h18v14H3z M8 6V4h8v2 M3 11h18 M10 11v3h4v-3" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="feedback" Label="反馈"
                                                          IconData="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="vote" Label="新功能投票"
                                                          IconData="M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                            <TextBlock Margin="13,10,5,3" FontSize="12" Foreground="#6F7C8B" Text="诊断" />
                            <controls:PclNavigationButton Classes="secondary-navigation" Click="MoreNavigationClick" Tag="logs" Label="查看日志"
                                                          IconData="M4 2h16v20H4z M8 7h8 M8 11h8 M8 15h5" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" Classes="pcl-page-right" Background="#D9EAF9">
                    <StackPanel x:Name="MoreContentHost" Margin="25,25,25,10" MaxWidth="860" Spacing="15">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="MorePageTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PclThemePrimaryBrush}" Text="帮助" />
                            <TextBlock x:Name="MorePageDescription" Foreground="#6F7C8B"
                                       Text="查看启动、下载、实例与故障排查入口。" />
                        </StackPanel>

                        <Border x:Name="MoreDirectorySection" Classes="pcl-card" Padding="20" Background="#FCFDFF" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="百宝箱" />
                                <TextBlock Foreground="#6F7C8B" Text="常用目录与跨平台维护工具。" />
                                <Separator />
                                <TextBlock FontWeight="SemiBold" Text="游戏目录" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="在系统文件管理器中打开当前 Minecraft 根目录。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding MinecraftRootDirectory}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding OpenGameDirectoryCommand}" Content="打开游戏目录" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding GameDirectorySummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreLogSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏日志" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding GameLogSummary}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ClearGameLogsCommand}"
                                        IsEnabled="{Binding HasGameLogLines}"
                                        Content="清除本次会话日志" />
                                <Border MaxHeight="260"
                                        Padding="12"
                                        Background="#FCFDFF"
                                        CornerRadius="8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GameLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Menlo, Consolas, monospace"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreAboutSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="PCL Aurora" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="当前发行、更新说明与安装包均由 PCL Aurora 的 GitHub Releases 提供。"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding OpenAuroraReleasesCommand}"
                                        Content="获取 PCL Aurora 最新版本" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="{Binding AuroraReleaseSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="PCL 与 PCL-CE 归属说明" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="PCL Aurora 是基于 Plain Craft Launcher（PCL）及 PCL-CE 的第三方跨平台迁移与二次创作项目，并非官方项目。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="原作者：龙腾猫跃（成都瓜皮龙科技有限公司）· 赞助链接：https://meloong.com/afd/a/LTCat"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="直接适配内容及其分发遵循随附的上游许可证和 NOTICE；Micro-ATP 的新增内容适用根目录许可证。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="界面字体" />
                                <TextBlock Foreground="#6F7C8B"
                                           Text="本软件使用 HarmonyOS Sans SC 字体，字体版权归 Huawei Device Co., Ltd. 所有。字体许可协议随软件一同提供。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MorePlaceholderSection" Classes="pcl-card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="MorePlaceholderTitle" FontSize="17" FontWeight="SemiBold" Text="帮助" />
                                <TextBlock x:Name="MorePlaceholderDescription" Foreground="#6F7C8B" TextWrapping="Wrap" />
                                <!-- PCL2 PageOtherHelp.xaml uses a search field above its local help topics. -->
                                <TextBox x:Name="MoreHelpSearchBox" Height="34" IsVisible="False"
                                         PlaceholderText="搜索帮助" TextChanged="MoreHelpSearchTextChanged" />
                                <Separator />
                                <ItemsControl x:Name="MorePlaceholderItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="pcl-option-row">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14"
                                                               Foreground="#6F7C8B" Text="›" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Direct Avalonia adaptation of PCL/PCL-CE MyMsgLogin.xaml. -->
        <Grid Grid.RowSpan="2"
              ZIndex="100"
              Background="#730D2438"
              IsVisible="{Binding IsMicrosoftLoginRunning}">
            <Border Width="520"
                    MinHeight="248"
                    MaxHeight="420"
                    Margin="25"
                    Padding="22,20,22,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FBFCFE"
                    BorderBrush="#BFD2E4"
                    BorderThickness="1"
                    CornerRadius="7"
                    BoxShadow="0 8 24 2 #590B2338">
                <Grid RowDefinitions="Auto,2,16,*,Auto">
                    <TextBlock Grid.Row="0"
                               Margin="7,0,70,9"
                               FontSize="23"
                               Foreground="{StaticResource PclThemePrimaryBrush}"
                               Text="登录 Minecraft" />
                    <Border Grid.Row="1" Height="2" Background="{StaticResource PclThemePrimaryBrush}" />

                    <Grid Grid.Row="3" MinHeight="122" Margin="7,0,7,17">
                        <controls:PclLoadingIndicator IsVisible="{Binding !HasMicrosoftDeviceCode}"
                                                      MinHeight="122"
                                                      Text="正在准备登录…" />
                        <StackPanel IsVisible="{Binding HasMicrosoftDeviceCode}"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock FontSize="15"
                                       Foreground="#536271"
                                       Text="登录网页已经打开，设备代码也已复制。请在浏览器中完成 Microsoft 账户授权。"
                                       TextWrapping="Wrap" />
                            <Border Padding="14,9"
                                    Background="#EAF2FE"
                                    BorderBrush="#96C0F9"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           Foreground="#0B5BCB"
                                           Text="{Binding MicrosoftDeviceCode}" />
                            </Border>
                            <TextBlock FontSize="13"
                                       Foreground="#758392"
                                       Text="也可以在其他设备中打开 microsoft.com/devicelogin 并输入此代码。"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="13"
                                       Foreground="#3E7BB4"
                                       Text="{Binding MicrosoftLoginSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4"
                                Margin="150,0,8,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Button Height="32"
                                Padding="10,0"
                                Command="{Binding OpenMicrosoftVerificationPageCommand}"
                                IsEnabled="{Binding CanOpenMicrosoftVerificationPage}"
                                Content="重新打开网页" />
                        <Button Height="32"
                                Padding="10,0"
                                Click="CopyMicrosoftCodeClick"
                                IsEnabled="{Binding HasMicrosoftDeviceCode}"
                                Content="复制代码" />
                        <Button Height="32"
                                MinWidth="64"
                                Padding="10,0"
                                Command="{Binding CancelMicrosoftLoginCommand}"
                                IsEnabled="{Binding CanCancelMicrosoftLogin}"
                                Content="取消" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>

    <Popup x:Name="CommunityFavoriteMenuPopup"
           Placement="BottomEdgeAlignedRight"
           IsLightDismissEnabled="True"
           VerticalOffset="4">
        <Border MinWidth="220" MaxWidth="280" Padding="5"
                Background="#FCFDFF" BorderBrush="#BFD3E6" BorderThickness="1"
                CornerRadius="5" BoxShadow="0 4 12 0 #30000000">
            <StackPanel x:Name="CommunityFavoriteMenuItems" Spacing="2" />
        </Border>
    </Popup>

    <Border Height="6" Margin="7,0" VerticalAlignment="Top" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeWindowPointerPressed" />
    <Border Height="6" Margin="7,0" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="6" Margin="0,7" HorizontalAlignment="Left" Background="Transparent"
            Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="6" Margin="0,7" HorizontalAlignment="Right" Background="Transparent"
            Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
            Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
            Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeWindowPointerPressed" />
    <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeWindowPointerPressed" />
    </Grid>

</Window>
