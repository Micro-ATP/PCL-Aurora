        <Style Selector="controls|PclNavigationButton.secondary-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <ControlTemplate TargetType="controls:PclNavigationButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                      Data="{TemplateBinding IconData}"
                                      Stretch="Uniform"
                                      Fill="Transparent"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Label}" />
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="3" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource PclThemePrimaryBrush}" CornerRadius="0,2,2,0"
                                IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
