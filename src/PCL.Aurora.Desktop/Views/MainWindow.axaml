<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Aurora.Desktop.ViewModels"
        xmlns:controls="using:PCL.Aurora.Desktop.Controls"
        xmlns:converters="using:PCL.Aurora.Desktop.Converters"
        xmlns:domain="using:PCL.Aurora.Domain"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="PCL.Aurora.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Width="850"
        Height="500"
        MinWidth="810"
        MinHeight="470"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="PCL Aurora">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:MinecraftVersionIconConverter x:Key="MinecraftVersionIconConverter" />
        <converters:MinecraftLoaderIconConverter x:Key="MinecraftLoaderIconConverter" />
        <StreamGeometry x:Key="DownloadRefreshIcon">M20 11a8.1 8.1 0 0 0-15.5-2 M4 4v5h5 M4 13a8.1 8.1 0 0 0 15.5 2 M20 20v-5h-5</StreamGeometry>
        <StreamGeometry x:Key="VersionInfoIcon">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 10v7 M12 7h.01</StreamGeometry>
        <StreamGeometry x:Key="VersionServerIcon">M4 4h16v6H4z M4 14h16v6H4z M8 7h.01 M8 17h.01</StreamGeometry>
        <StreamGeometry x:Key="VersionExpandDownIcon">M7 10l5 5 5-5</StreamGeometry>
        <StreamGeometry x:Key="VersionExpandUpIcon">M7 14l5-5 5 5</StreamGeometry>
        <StreamGeometry x:Key="CommunityVersionIcon">M3 6h18 M3 12h18 M3 18h18</StreamGeometry>
        <StreamGeometry x:Key="CommunityDownloadIcon">M12 3v12 M7 10l5 5 5-5 M5 21h14</StreamGeometry>
        <StreamGeometry x:Key="CommunityTimeIcon">M12 19V5 M5 12l7-7 7 7 M5 21h14</StreamGeometry>
        <StreamGeometry x:Key="CommunitySourceIcon">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15.3 15.3 0 0 1 0 20 M12 2a15.3 15.3 0 0 0 0 20</StreamGeometry>
        <StreamGeometry x:Key="CommunityBackIcon">M19 12H5 M12 19l-7-7 7-7</StreamGeometry>
        <StreamGeometry x:Key="CommunityCopyIcon">M8 8h12v12H8z M4 16H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1</StreamGeometry>
        <StreamGeometry x:Key="CommunityHeartIcon">M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8z</StreamGeometry>

        <DataTemplate x:Key="CommunityProjectRowTemplate" x:DataType="vm:CommunityResourceItemViewModel">
            <Grid Classes="community-project-item" Height="64" ClipToBounds="True">
                <Button Classes="community-project-row" Tag="{Binding}" Click="CommunityResourceOpenClick"
                        AutomationProperties.Name="{Binding Project.DisplayTitle, StringFormat=查看项目 {0}}" />
                <Grid Margin="7,0,7,0" ColumnDefinitions="50,8,*" RowDefinitions="5,20,18,16,5"
                      IsHitTestVisible="False">
                    <Border Grid.Row="1" Grid.RowSpan="3" Width="50" Height="50" VerticalAlignment="Center"
                            Background="#DCEEFF" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#1370F3"
                                       IsVisible="{Binding !HasIcon}" Text="{Binding Initial}" />
                            <Image Width="50" Height="50" Stretch="UniformToFill"
                                   IsVisible="{Binding HasIcon}" Source="{Binding Icon}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="0">
                        <TextBlock FontSize="14" Foreground="#36424F" Text="{Binding Project.DisplayTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="#8B96A1" Text="{Binding Project.OriginalTitleDisplay}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <ItemsControl ItemsSource="{Binding Project.CategoryTags}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="3,1" Background="#E9EDF1" CornerRadius="3">
                                        <TextBlock FontSize="11" Foreground="#7B8794" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#7B8794"
                                   Text="{Binding Project.Description}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Project.Description}" />
                    </Grid>
                    <Grid Grid.Row="3" Grid.Column="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="4" MinWidth="0">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityVersionIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#7B8794" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#7B8794" Text="{Binding Project.CompatibilityDisplay}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityDownloadIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.CompactDownloadCountDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunityTimeIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.LastUpdatedRelativeDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Path Width="12" Height="12" Data="{StaticResource CommunitySourceIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="#87929D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock FontSize="12" Foreground="#87929D" Text="{Binding Project.SourceDisplay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Classes="community-row-action-surface" HorizontalAlignment="Right"
                        VerticalAlignment="Stretch" Padding="12,0,5,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <Button Classes="community-row-action" Tag="{Binding}" Click="CommunityResourceQuickDownloadClick"
                                ToolTip.Tip="快速下载" AutomationProperties.Name="快速下载">
                            <Path Width="15" Height="15" Data="{StaticResource CommunityDownloadIcon}" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button Classes="community-row-action" Tag="{Binding}" Click="CommunityResourceFavoriteClick"
                                ToolTip.Tip="收藏" AutomationProperties.Name="管理收藏">
                            <Grid Width="15" Height="15">
                                <Path Width="15" Height="15" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                      Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsVisible="{Binding !IsFavorite}" />
                                <Path Width="15" Height="15" Data="{StaticResource CommunityHeartIcon}" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                      IsVisible="{Binding IsFavorite}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OfficialVersionRowTemplate" x:DataType="domain:MinecraftVersionCatalogEntry">
            <Border Classes="official-version-row">
                <Grid>
                    <Button Classes="official-version-main" Tag="{Binding}" Click="OfficialVersionOpenClick"
                            AutomationProperties.Name="{Binding Id, StringFormat=下载 Minecraft {0}}">
                        <Grid ColumnDefinitions="34,*" ColumnSpacing="8">
                            <Image Width="30" Height="30" VerticalAlignment="Center" Stretch="Uniform"
                                   Source="{Binding Converter={StaticResource MinecraftVersionIconConverter}}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock FontSize="14" Text="{Binding Id}" />
                                <TextBlock FontSize="11" Foreground="#88929D"
                                           Text="{Binding ReleaseTime, StringFormat={}{0:yyyy/M/d HH:mm}}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <StackPanel Classes="version-actions" Margin="0,0,6,0" Panel.ZIndex="1"
                                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                        <Button Classes="version-row-action" Tag="{Binding}" Click="OfficialVersionChangelogClick"
                                ToolTip.Tip="更新日志" AutomationProperties.Name="{Binding Id, StringFormat=查看 Minecraft {0} 更新日志}">
                            <Path Width="18" Height="18" Data="{StaticResource VersionInfoIcon}" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                        <Button Classes="version-row-action" Tag="{Binding}" Click="OfficialVersionServerClick"
                                ToolTip.Tip="下载服务端" AutomationProperties.Name="{Binding Id, StringFormat=下载 Minecraft {0} 服务端}">
                            <Path Width="18" Height="18" Data="{StaticResource VersionServerIcon}" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Visual structure adapted for Avalonia from PCL2 FormMain.xaml and its
             PageLaunch, PageDownload, PageSetup and PageOther XAML, with PCL-CE's
             expanded download/setup navigation. Aurora retains cross-platform bindings. -->
        <Style Selector="Button.main-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="13.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Margin" Value="5,10" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.main-navigation:pointerover">
            <Setter Property="Background" Value="#4890F5" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.main-navigation.selected">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="Border.launch-side">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.pcl-card">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="#D1DDEA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.pcl-notice">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="#CADBEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.pcl-status-strip">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Border.pcl-option-row">
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="BorderBrush" Value="#E0E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Button.launch-button">
            <Setter Property="Background" Value="#1370F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.launch-download-button">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="Foreground" Value="#1370F3" />
            <Setter Property="BorderBrush" Value="#1370F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Border.side-selection">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#1370F3" />
        </Style>
        <Style Selector="controls|PclNavigationButton.secondary-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <ControlTemplate TargetType="controls:PclNavigationButton">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                                <Path Width="16" Height="16" VerticalAlignment="Center"
                                      Data="{TemplateBinding IconData}"
                                      Stretch="Uniform"
                                      Fill="Transparent"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Label}" />
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="3" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#1370F3" CornerRadius="0,2,2,0"
                                IsVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|PclNavigationButton.secondary-navigation:pointerover">
            <Setter Property="Background" Value="#E4F1FF" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="controls|PclNavigationButton.secondary-navigation.selected">
            <Setter Property="Background" Value="#1370F3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="controls|PclNavigationButton.secondary-navigation.selected:pointerover">
            <Setter Property="Background" Value="#2B86ED" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="controls|PclNavigationButton.secondary-navigation:focus-visible">
            <Setter Property="BorderBrush" Value="#1370F3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBlock">
            <Setter Property="Foreground" Value="#36424F" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="CaretBrush" Value="#1370F3" />
            <Setter Property="SelectionBrush" Value="#C7E1FA" />
            <Setter Property="PlaceholderForeground" Value="#8291A2" />
            <Setter Property="BorderBrush" Value="#C3D2E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C3D2E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:pointerover">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="BorderBrush" Value="#8DB9E2" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="BorderBrush" Value="#8DB9E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:focus">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:disabled">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="Foreground" Value="#8C98A6" />
            <Setter Property="PlaceholderForeground" Value="#A0AAB5" />
            <Setter Property="BorderBrush" Value="#DEE5EC" />
        </Style>
        <Style Selector="Grid.pcl-shell TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#DEE5EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="PlaceholderForeground" Value="#8291A2" />
            <Setter Property="BorderBrush" Value="#C3D2E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C3D2E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="#526170" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="BorderBrush" Value="#83B8F8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:pointerover">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="BorderBrush" Value="#8DB9E2" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#F8FBFE" />
            <Setter Property="BorderBrush" Value="#8DB9E2" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:pressed">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:focus">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="Foreground" Value="#273444" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="#F2F8FF" />
            <Setter Property="BorderBrush" Value="#5A9DE0" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="#E4F1FF" />
            <Setter Property="BorderBrush" Value="#1370F3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:disabled">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="Foreground" Value="#8C98A6" />
            <Setter Property="PlaceholderForeground" Value="#A0AAB5" />
            <Setter Property="BorderBrush" Value="#DEE5EC" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:disabled /template/ Border#Background">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#DEE5EC" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:disabled /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="#7C8794" />
        </Style>
        <Style Selector="Grid.pcl-shell ComboBox:disabled /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="#9AA5B1" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#F0F7FF" />
            <Setter Property="Foreground" Value="#36424F" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#E4F1FF" />
            <Setter Property="Foreground" Value="#36424F" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#DCEEFF" />
            <Setter Property="Foreground" Value="#36424F" />
        </Style>
        <Style Selector="ComboBoxItem:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA5B1" />
        </Style>
        <Style Selector="Grid.pcl-shell CheckBox">
            <Setter Property="Foreground" Value="#36424F" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.pcl-shell Button">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="Foreground" Value="#344150" />
            <Setter Property="BorderBrush" Value="#C8D4E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
