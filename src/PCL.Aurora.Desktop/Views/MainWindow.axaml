<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCL.Aurora.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="PCL.Aurora.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Icons/AppIcon.ico"
        Width="1060"
        Height="680"
        MinWidth="800"
        MinHeight="560"
        Title="PCL Aurora">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- PCL uses one compact title and navigation band rather than a separate tab strip. -->
        <Style Selector="TabControl /template/ TabStrip">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.main-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="8,9" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <Style Selector="Button.main-navigation:pointerover">
            <Setter Property="Background" Value="#247DF5" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.main-navigation.selected">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1370F3" />
        </Style>
        <Style Selector="Border.launch-side">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Border.pcl-card">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.launch-button">
            <Setter Property="Background" Value="#1370F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.launch-download-button">
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="Foreground" Value="#1370F3" />
            <Setter Property="BorderBrush" Value="#1370F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Border.side-selection">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#1370F3" />
        </Style>
        <Style Selector="Button.secondary-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.secondary-navigation:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
        <Style Selector="Button.secondary-navigation.selected">
            <Setter Property="Background" Value="#1370F3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="48,*">
        <Border Background="#1370F3">
            <Grid ColumnDefinitions="260,Auto,*,Auto">
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="PCL Aurora" />
                    <TextBlock FontSize="10" Foreground="#D9E8FF" Text="跨平台迁移版" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LaunchNavigation" Classes="main-navigation selected" Tag="0" Click="MainNavigationClick" Content="▶  启动" />
                    <Button x:Name="DownloadNavigation" Classes="main-navigation" Tag="1" Click="MainNavigationClick" Content="⇩  下载" />
                    <Button x:Name="SettingsNavigation" Classes="main-navigation" Tag="2" Click="MainNavigationClick" Content="⚙  设置" />
                    <Button x:Name="MoreNavigation" Classes="main-navigation" Tag="3" Click="MainNavigationClick" Content="▦  更多" />
                </StackPanel>
                <TextBlock Grid.Column="3" Margin="0,0,18,0" VerticalAlignment="Center"
                           Foreground="#D9E8FF" FontSize="12" Text="Minecraft Launcher" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0" SelectedIndex="0">
            <TabItem>
                <Grid ColumnDefinitions="300,*" Background="#D9EAF9">
                    <Border Background="#FCFCFD" BorderBrush="#D7DCE2" BorderThickness="0,0,1,0">
                        <Grid Margin="20,22" RowDefinitions="Auto,*,Auto,Auto">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="18">
                                <Button Command="{Binding StartMicrosoftLoginCommand}"
                                        IsEnabled="{Binding CanStartMicrosoftLogin}" Content="正版" />
                                <Button Classes="launch-button" Command="{Binding UseOfflineAccountCommand}" Content="离线" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14">
                                <Border Width="56" Height="56" CornerRadius="3" HorizontalAlignment="Center" Background="#F0B07A">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White" Text="A" />
                                </Border>
                                <TextBox PlaceholderText="游戏用户名" Text="{Binding OfflinePlayerName}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <Button Command="{Binding RestoreMicrosoftLoginCommand}" IsEnabled="{Binding CanRestoreMicrosoftLogin}" Content="恢复" />
                                    <Button Command="{Binding ClearMicrosoftLoginCommand}" IsEnabled="{Binding CanClearMicrosoftLogin}" Content="清除" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="6">
                                <Button Classes="launch-download-button" Click="OpenDownloadPageClick"
                                        IsVisible="{Binding NeedsGameDownload}" Height="52" FontSize="16" Content="下载游戏" />
                                <Button Classes="launch-button" Command="{Binding LaunchGameCommand}"
                                        IsVisible="{Binding HasAvailableInstances}"
                                        IsEnabled="{Binding CanLaunchGame}" Height="52" FontSize="16" Content="启动游戏" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding InstanceSummary}" TextWrapping="Wrap" />
                                <Button Classes="launch-download-button" Click="OpenDownloadPageClick"
                                        Height="42" FontSize="15" Content="版本选择" />
                            </StackPanel>
                            <ComboBox Grid.Row="3" x:Name="InstanceSelector" Margin="0,12,0,0"
                                      AutomationProperties.Name="启动实例"
                                      IsVisible="{Binding HasAvailableInstances}"
                                      ItemsSource="{Binding AvailableInstances}"
                                      SelectedItem="{Binding SelectedInstance}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       Text="{Binding VersionDisplay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#D9EAF9">
                        <StackPanel Margin="28" Width="460" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsVisible="{Binding HasAvailableInstances}" Spacing="12">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="启动状态" />
                            <TextBlock Text="{Binding GameLaunchSummary}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="{Binding LaunchPreflightSummary}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="{Binding VersionMetadataSummary}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="{Binding JavaRequirementSummary}" TextWrapping="Wrap" />
                            <CheckBox IsEnabled="{Binding RequiresAccountGuidance}"
                                      IsChecked="{Binding HasAcknowledgedAccountGuidance}"
                                      Content="我已知悉正版购买与上游赞助提示。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <Grid ColumnDefinitions="152,*">
                    <Border Padding="0,12,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Spacing="4">
                            <Button x:Name="DownloadGameNavigation" Classes="secondary-navigation selected"
                                    Click="DownloadNavigationClick" Tag="game" Content="原版游戏" />
                            <TextBlock Margin="13,12,5,4" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="社区资源" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="模组 · 待迁移" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="整合包 · 待迁移" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="资源包与光影 · 待迁移" />
                            <TextBlock Margin="13,12,5,4" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="安装" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="OptiFine · 待迁移" />
                            <Button x:Name="DownloadLoaderNavigation" Classes="secondary-navigation"
                                    Click="DownloadNavigationClick" Tag="loader" Content="Forge / Fabric" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1">
                    <StackPanel Margin="25,10,25,25" MaxWidth="860" Spacing="15">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DownloadPageTitle" FontSize="20" FontWeight="SemiBold" Foreground="#1370F3" Text="原版游戏" />
                            <TextBlock x:Name="DownloadPageDescription" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="选择官方 Minecraft 版本，再创建本地实例并执行已验证的安装流程。" />
                        </StackPanel>

                        <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Left">
                            <Border x:Name="DownloadCommunityCard" Width="300" Margin="0,0,16,16" Padding="20" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="社区资源" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="模组、整合包、数据包、资源包、光影与存档。" TextWrapping="Wrap" />
                                    <Button IsEnabled="False" Content="浏览资源" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DownloadGameCard" Classes="pcl-card" Width="620" Margin="0,0,16,16" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="游戏安装" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="先选择官方 Minecraft 版本，再创建本地实例并下载。" TextWrapping="Wrap" />
                                    <TextBlock Text="搜索版本 ID" />
                                    <TextBox PlaceholderText="例如 1.21.4 或 24w14a"
                                             Text="{Binding VersionSearchText}" />
                                    <WrapPanel ItemHeight="32" ItemWidth="92">
                                        <CheckBox Content="正式版" IsChecked="{Binding IncludeReleaseVersions}" />
                                        <CheckBox Content="快照" IsChecked="{Binding IncludeSnapshotVersions}" />
                                        <CheckBox Content="旧版" IsChecked="{Binding IncludeLegacyVersions}" />
                                    </WrapPanel>
                                    <ComboBox ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedCatalogVersion}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Id}" />
                                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               Text="{Binding Type}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding RefreshVersionCatalogCommand}" Content="刷新官方版本" />
                                    <Button Command="{Binding ProvisionSelectedVersionCommand}" IsEnabled="{Binding CanProvisionSelectedVersion}" Content="创建所选实例" />
                                    <Button Command="{Binding InstallGameCommand}" IsEnabled="{Binding CanInstallGame}" Content="安装所选本地实例" />
                                    <Button Command="{Binding CancelInstallationCommand}"
                                            IsEnabled="{Binding CanCancelInstallation}"
                                            Content="取消当前下载" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="DownloadLoaderCard" Classes="pcl-card" Width="620" Margin="0,0,16,16" Padding="20" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="模组加载器" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="导入用户指定的本地目录，按所选原版版本筛选 Forge、NeoForge 和 Fabric。"
                                               TextWrapping="Wrap" />
                                    <TextBox PlaceholderText="本地 loaders.json 的完整路径"
                                             Text="{Binding LoaderCatalogPath}" />
                                    <Button Command="{Binding LoadLoaderCatalogCommand}" Content="读取本地加载器目录" />
                                    <Button Command="{Binding RefreshOfficialLoaderCatalogCommand}" Content="刷新官方加载器目录" />
                                    <ComboBox IsEnabled="{Binding HasAvailableLoaders}"
                                              ItemsSource="{Binding AvailableLoaders}"
                                              SelectedItem="{Binding SelectedLoader}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
                                                    <TextBlock Text="{Binding Version}" />
                                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                               Text="{Binding Channel}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding InstallSelectedLoaderCommand}"
                                            IsEnabled="{Binding CanInstallSelectedLoader}"
                                            Content="下载并安装所选加载器" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="{Binding LoaderCatalogSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               Text="{Binding LoaderSelectionSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding DownloadPreparationSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding InstallationSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding VersionCatalogSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <Grid ColumnDefinitions="152,*">
                    <Border Padding="0,12,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Spacing="4">
                            <Button x:Name="SettingsLaunchNavigation" Classes="secondary-navigation selected"
                                    Click="SettingsNavigationClick" Tag="launch" Content="启动" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="联机 · 待迁移" />
                            <Button x:Name="SettingsInterfaceNavigation" Classes="secondary-navigation"
                                    Click="SettingsNavigationClick" Tag="interface" Content="个性化" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="其他 · 待迁移" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1">
                    <StackPanel Margin="25,25,25,10" MaxWidth="860" Spacing="15">

                        <Border x:Name="SettingsLaunchSection" Classes="pcl-card" Padding="20" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="启动选项" />
                                <TextBlock FontWeight="SemiBold" Text="Java 与运行环境" />
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" RowSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="系统架构" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text=".NET 运行时" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据目录" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApplicationDataDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="缓存目录" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CacheDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Java" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding JavaSummary}" TextWrapping="Wrap" />
                                </Grid>
                                <Label Content="启动 Java" Target="{Binding #JavaSelector}" />
                                <ComboBox x:Name="JavaSelector"
                                          MinWidth="360"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="启动 Java"
                                          IsEnabled="{Binding HasAvailableJavaInstallations}"
                                          ItemsSource="{Binding AvailableJavaInstallations}"
                                          SelectedItem="{Binding SelectedJava}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding Vendor}" />
                                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding ExecutablePath}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="仅显示与当前架构兼容的 Java；选择仅在本次运行生效。"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="刷新 Java 诊断" />

                                <Separator Margin="0,6" />
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="游戏启动" />
                                <Label Content="窗口模式" Target="{Binding #GameWindowModeSelector}" />
                                <ComboBox x:Name="GameWindowModeSelector"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Minecraft 窗口模式"
                                          ItemsSource="{Binding GameWindowModes}"
                                          SelectedItem="{Binding SelectedGameWindowMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel IsEnabled="{Binding UsesCustomGameWindowSize}" Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="宽度" />
                                    <TextBox Width="90" AutomationProperties.Name="自定义 Minecraft 窗口宽度"
                                             Text="{Binding CustomGameWindowWidth}" />
                                    <TextBlock VerticalAlignment="Center" Text="×" />
                                    <TextBox Width="90" AutomationProperties.Name="自定义 Minecraft 窗口高度"
                                             Text="{Binding CustomGameWindowHeight}" />
                                    <TextBlock VerticalAlignment="Center" Text="高度" />
                                </StackPanel>
                                <Label Content="内存分配" Target="{Binding #MemoryAllocationModeSelector}" />
                                <ComboBox x:Name="MemoryAllocationModeSelector"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Minecraft 内存分配模式"
                                          ItemsSource="{Binding MemoryAllocationModes}"
                                          SelectedItem="{Binding SelectedMemoryAllocationMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel IsEnabled="{Binding UsesCustomMemoryAllocation}" Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="自定义堆内存" />
                                    <TextBox Width="120" AutomationProperties.Name="自定义 Minecraft 堆内存（MiB）"
                                             Text="{Binding CustomMemoryMiB}" />
                                    <TextBlock VerticalAlignment="Center" Text="MiB" />
                                </StackPanel>
                                <TextBlock Text="额外 JVM 参数" />
                                <TextBox AcceptsReturn="True" Height="80" MaxLength="4000"
                                         PlaceholderText="例如：-Xmx4G -Dexample=value"
                                         Text="{Binding AdditionalJvmArguments}" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" />
                                <TextBlock Text="额外游戏参数" />
                                <TextBox AcceptsReturn="True" Height="80" MaxLength="4000"
                                         PlaceholderText="例如：--demo"
                                         Text="{Binding AdditionalGameArguments}" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" />
                                <Button Command="{Binding SaveLaunchOptionsCommand}"
                                        HorizontalAlignment="Left" Content="保存启动选项" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding LaunchOptionsSummary}" TextWrapping="Wrap" />

                                <Separator Margin="0,6" />
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="下载设置" />
                                <Label Content="最大下载连接数" Target="{Binding #DownloadConcurrencySelector}" />
                                <ComboBox x:Name="DownloadConcurrencySelector"
                                          Width="240" HorizontalAlignment="Left"
                                          AutomationProperties.Name="最大下载连接数"
                                          ItemsSource="{Binding DownloadConcurrencyOptions}"
                                          SelectedItem="{Binding SelectedDownloadConcurrency}" />
                                <Label Content="总下载限速" Target="{Binding #DownloadSpeedSelector}" />
                                <ComboBox x:Name="DownloadSpeedSelector"
                                          Width="240" HorizontalAlignment="Left"
                                          AutomationProperties.Name="总下载限速"
                                          ItemsSource="{Binding DownloadSpeedOptions}"
                                          SelectedItem="{Binding SelectedDownloadSpeedLimit}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding DownloadSettingsSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsInterfaceSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1370F3" Text="个性化" />
                                <Label Content="主题模式" Target="{Binding #ThemeModeSelector}" />
                                <ComboBox x:Name="ThemeModeSelector"
                                          Width="240"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="主题模式"
                                          ItemsSource="{Binding ThemeModes}"
                                          SelectedItem="{Binding SelectedThemeMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding ThemeSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="主题偏好只保存在本机；不保存账户密码或令牌。语言、更新与反馈将在对应服务完成后启用。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <Grid ColumnDefinitions="152,*">
                    <Border Padding="0,12,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Spacing="4">
                            <Button x:Name="MoreDirectoryNavigation" Classes="secondary-navigation selected"
                                    Click="MoreNavigationClick" Tag="directory" Content="游戏目录" />
                            <Button x:Name="MoreLogsNavigation" Classes="secondary-navigation"
                                    Click="MoreNavigationClick" Tag="logs" Content="游戏日志" />
                            <Button x:Name="MoreAboutNavigation" Classes="secondary-navigation"
                                    Click="MoreNavigationClick" Tag="about" Content="关于与鸣谢" />
                            <TextBlock Margin="12,8" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Text="帮助与反馈 · 待迁移" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1">
                    <StackPanel Margin="25,25,25,10" MaxWidth="860" Spacing="15">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#1370F3" Text="更多" />
                            <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="联机、游戏目录、日志与维护工具。" />
                        </StackPanel>

                        <Border x:Name="MoreDirectorySection" Classes="pcl-card" Padding="20" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏目录" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="在系统文件管理器中打开当前 Minecraft 根目录。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding MinecraftRootDirectory}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left" Command="{Binding OpenGameDirectoryCommand}" Content="打开游戏目录" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding GameDirectorySummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreLogSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="游戏日志" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="{Binding GameLogSummary}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding ClearGameLogsCommand}"
                                        IsEnabled="{Binding HasGameLogLines}"
                                        Content="清除本次会话日志" />
                                <Border MaxHeight="260"
                                        Padding="12"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GameLogLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Menlo, Consolas, monospace"
                                                               Text="{Binding DisplayText}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MoreAboutSection" Classes="pcl-card" Padding="20" IsVisible="False">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="PCL 与 PCL-CE 归属说明" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="PCL Aurora 是基于 Plain Craft Launcher（PCL）及 PCL-CE 的第三方跨平台迁移与二次创作项目，并非官方项目。"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="原作者：龙腾猫跃（成都瓜皮龙科技有限公司）· 赞助链接：https://meloong.com/afd/a/LTCat"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           Text="直接适配内容及其分发遵循随附的上游许可证和 NOTICE；Micro-ATP 的新增内容适用根目录许可证。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
