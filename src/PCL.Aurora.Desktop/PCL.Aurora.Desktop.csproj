<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PclAuroraMicrosoftClientId Condition="'$(PclAuroraMicrosoftClientId)' == ''">$(PCL_AURORA_MS_CLIENT_ID)</PclAuroraMicrosoftClientId>
  </PropertyGroup>

  <ItemGroup Condition="'$(PclAuroraMicrosoftClientId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PclAuroraMicrosoftClientId</_Parameter1>
      <_Parameter2>$(PclAuroraMicrosoftClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="../../Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Regular.ttf"
                      Link="Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Regular.ttf" />
    <AvaloniaResource Include="../../Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Light.ttf"
                      Link="Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Light.ttf" />
    <AvaloniaResource Include="../../Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Medium.ttf"
                      Link="Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Medium.ttf" />
    <AvaloniaResource Include="../../Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Bold.ttf"
                      Link="Fonts/HarmonyOS_Sans_SC/HarmonyOS_Sans_SC_Bold.ttf" />
    <None Include="../../Fonts/HarmonyOS_Sans_SC/LICENSE.txt"
          Link="LICENSES/HarmonyOS-Sans-Fonts.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../PCL.Aurora.Application/PCL.Aurora.Application.csproj" />
    <ProjectReference Include="../PCL.Aurora.Infrastructure/PCL.Aurora.Infrastructure.csproj" />
    <ProjectReference Include="../PCL.Aurora.Platform.MacOS/PCL.Aurora.Platform.MacOS.csproj" />
  </ItemGroup>
</Project>
